    document.getElementById('my-card-count-6p').textContent = fmtCount(myHand.length);
  } else {
    renderHand(myHand);
    syncButtons();
    updateSelInfo();
    document.getElementById('my-card-count').textContent = fmtCount(myHand.length);
  }
});

/* ── 无效出牌 ── */
socket.on('play:invalid',   function(d){ showToast(d.message); });

/* ── 玩家出完牌 ── */
socket.on('player:finished', function(d){
  var lbl = POS_LABELS[d.position] || d.position + '游';
  showToast('🎉 ' + esc(d.name) + ' · ' + lbl + '！', '#4CAF50');
});

/* ── 报牌（≤10张）── */
socket.on('game:baopai', function(d){
  var who = (d.seat === mySeat) ? '您' : esc(d.name);
  flashWon('📢 ' + who + ' 报牌：剩 ' + d.count + ' 张');
});

/* ── 赢回出牌权 ── */
socket.on('game:trick_won', function(d){
  /* 一墩结束、桌面清空：本地立即解除"必须压过"。若我是赢墩者(新先出方)，即使随后的
     game:state 广播丢包，也能自由出牌，杜绝"轮到我先出却永远压不过"死锁。*/
  hasLastPlay = false; lastPlayType = null;
  if(d.seat === mySeat){
    isMyTurn = true; _turnSeatCur = mySeat;
    syncButtons();
    flashWon('您赢回出牌权！');
  } else {
    syncButtons();
    var p = players.find(function(x){ return x.seat===d.seat; });
    if(p) flashWon(esc(p.name) + ' 先出');
  }
});

/* ── 游戏错误 ── */
socket.on('game:error', function(d){
