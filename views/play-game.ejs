function buildTributeLog(exchanges) {
  var logEl = document.getElementById('tribute-log');
  if (!logEl) return;
  logEl.innerHTML = '';
  exchanges.forEach(function(e) {
    var item = document.createElement('div');
    item.className = 'tribute-log-item' + ((e.done || e.stage === 'done') ? ' done' : '');
    if (e.resisted) item.textContent = '🛡️ 抗贡';
    else if (e.done || e.stage === 'done') item.textContent = '✅ 进贡 ' + cardEmoji(e.tributeCard) + ' ↔ 还 ' + cardEmoji(e.returnCard);
    else item.textContent = '⏳ 进贡中...';
    logEl.appendChild(item);
  });
}

/* 抗贡/提示浮层 */
function showTributeNotice(text, ms) {
