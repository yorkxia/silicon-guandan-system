/* ── 座位已被其他新玩家接手（开放纳新）→ 明确告知并给按钮重新随机参赛 ── */
socket.on('game:seat_taken', function(d){
  document.getElementById('loading-overlay').style.display = 'none';
  var mode = (d && d.mode === '6p') ? '6p' : '4p';
  try { gdLS.set('gd-active-room-' + mode, ''); } catch(e){}   // 已被接管→清掉返回入口，避免再点回来
  var inner = document.querySelector('#err-box .err-inner');
  if (inner) {
    inner.innerHTML =
      '<p id="err-msg" style="color:#F08080;margin:0 0 20px;font-size:.98rem;line-height:1.7;font-weight:700;">' +
        '您的被托管的位置已经被新的用户占据，抱歉！' +
      '</p>' +
      '<a href="/play/' + mode + '?auto=1" style="display:inline-block;padding:12px 28px;border-radius:12px;' +
        'background:linear-gradient(135deg,#27AE60,#1A7A40);color:#fff;font-weight:800;font-size:.92rem;' +
        'text-decoration:none;letter-spacing:1px;box-shadow:0 4px 14px rgba(39,174,96,.4);">🔄 重新随机参赛</a>' +
      '<div style="margin-top:16px;"><a href="/play" style="color:#FFE066;font-size:.82rem;">← 返回参赛大厅</a></div>';
  }
  document.getElementById('err-box').style.display = 'flex';
});

/* ── 局结算 ── */
socket.on('round:result', function(d){
  stopTurnCountdown();          // 阶段九：本局结束，停止倒计时
  clearSeatPlays();             // 清空贴座位的出牌
  /* 更新级牌 + 胜局，刷新左上面板 */
  if (typeof d.newLv1 !== 'undefined') levelTeam1 = d.newLv1;
  if (typeof d.newLv2 !== 'undefined') levelTeam2 = d.newLv2;
  if (typeof d.winsTeam1 !== 'undefined') winsTeam1 = d.winsTeam1;   // 胜局=过A盘胜(服务端权威)
  if (typeof d.winsTeam2 !== 'undefined') winsTeam2 = d.winsTeam2;
  if (typeof d.aFail1 !== 'undefined') aFail1 = d.aFail1;
  if (typeof d.aFail2 !== 'undefined') aFail2 = d.aFail2;
  updateCurrentLevel();
  var isWin = myTeam === d.winnerTeam;
  var el    = document.getElementById('result-type-text');
  el.className = 'result-type ' + (isWin?'win':'lose');

  var wTeam = d.winnerTeam===1 ? '甲队' : '乙队';
  if (d.guoA) {
    /* 过A：一轮(整盘)结束 */
    el.textContent = '🏆 ' + wTeam + ' 过A！';
    var lun = winsTeam1 + winsTeam2;   // 已完成的轮数
    document.getElementById('result-level-line').innerHTML =
      '<strong style="color:#FFE066;">第 ' + lun + ' 轮结束 · 成绩：甲队胜局 ' + winsTeam1 + ' / 乙队胜局 ' + winsTeam2 + '</strong>' +
      '<br><span style="font-size:.8rem;color:rgba(255,255,255,.7);">是否继续下一轮？（从打2开始）</span>';
  } else {
    el.textContent = d.resultType;
    document.getElementById('result-level-line').innerHTML =
      '<strong>' + wTeam + '升' + d.delta + '级 · 甲' + lvName(d.newLv1) + ' 乙' + lvName(d.newLv2) + '</strong>';
  }
  /* 按钮文案：过A→继续下一轮；普通→继续发牌 */
  var pbtn = document.getElementById('result-continue-btn');
  if (pbtn) pbtn.textContent = d.guoA ? '继续下一轮' : '继续发牌';

  var html = '';
  d.finishOrder.forEach(function(f){
    var isMine = f.seat===mySeat;
    var tName  = f.team===1 ? '甲队' : '乙队';
    html += '<div class="result-row">' +
      '<span class="result-pos ' + (POS_CLASS[f.position]||'') + '">' + (POS_LABELS[f.position]||f.position+'游') + '</span>' +
      '<span class="result-pname">' + esc(f.name) + (isMine?' <span style="color:#FFE066;font-size:.68rem;">（我）</span>':'') + '</span>' +
      '<span class="result-team-tag">' + tName + '</span>' +
    '</div>';
  });
  document.getElementById('result-order').innerHTML = html;
  /* 记录本局各座玩家：供"继续比赛"后在大屏上渲染等待座位 */
  _interSeats = (d.finishOrder || []).map(function(f){
    return { seat: f.seat, name: f.name, display_name: f.name, team: f.team };
  });
  document.getElementById('result-overlay').style.display = 'flex';
  startRoundContinueCountdown(!!d.majorityOffline);   // 45秒兜底续局 + 过半掉线开放纳新提示
});

/* ════════════════════ 渲染函数 ════════════════════ */

/* 相对位置映射 */
function buildRelMap(myS, total){
  var pos = total===4 ? ['bottom','right','top','left'] : ['bottom','right','top','top','left','left'];
  var map = {};
  for(var i=0;i<total;i++){
    var s = ((myS-1+i)%total)+1;
    map[s] = pos[i] || 'top';
  }
  return map;
}

/* 渲染所有对手玩家面板 */
function renderAllPlayers(pList, finOrder, turnSeat){
  if(!pList||!pList.length) return;
  var relMap = buildRelMap(mySeat, pList.length);
  var topP=[],leftP=null,rightP=null;

  pList.forEach(function(p){
    if(p.isMe) return;
    var rel = relMap[p.seat];
    if(rel==='top') topP.push(p);
    else if(rel==='left')  leftP  = p;
    else if(rel==='right') rightP = p;
  });

  // 对家（上方，4人赛为1人）
  fillPlayerBox('box-top','top-avatar','top-name','top-buddy','top-ccount','top-cards','top-finish',
    topP[0]||null, finOrder, turnSeat, 'h');

  // 左玩家
  fillPlayerBox('box-left','left-avatar','left-name','left-buddy','left-ccount','left-cards','left-finish',
    leftP, finOrder, turnSeat, 'v');

  // 右玩家
  fillPlayerBox('box-right','right-avatar','right-name','right-buddy','right-ccount','right-cards','right-finish',
    rightP, finOrder, turnSeat, 'v');
}

/* 干净方框：只显示昵称；昵称下方仅在 ≤10 张(报数)时显示牌数；打完后名次替换牌数。
   头像/队友字/牌背扇全部去除；队伍区分仅保留方框边框淡色。*/
function fillPlayerBox(boxId, avatarId, nameId, buddyId, ccountId, cardsId, finishId, p, finOrder, turnSeat, dir){
  var box = document.getElementById(boxId);
  if(!p){ box.style.display='none'; return; }
  box.style.display='flex';

  var isActive = (p.seat === turnSeat);
  var finItem  = (finOrder||[]).find(function(f){ return f.seat===p.seat; });
  var offline  = (connMap[p.seat] === false);

  /* 名字（唯一常显信息）*/
  var nameEl = document.getElementById(nameId);
  nameEl.textContent = (p.name || '—') + (offline ? ' 🤖托管' : '');
  nameEl.className   = 'pbox-name' + (isActive?' active':'') + (offline?' offline':'');

  /* 名次徽章 or ≤10 报数 or 空 */
  var ccEl  = document.getElementById(ccountId);
  var finEl = document.getElementById(finishId);
  if(finItem){
    finEl.textContent   = POS_LABELS[finItem.position] || finItem.position+'游';
    finEl.className     = 'finish-badge ' + (POS_CLASS[finItem.position]||'');
    finEl.style.display = 'inline-block';
    ccEl.textContent = ''; ccEl.className = 'card-count-badge';
  } else {
    finEl.style.display = 'none';
    var showCount = (p.cardCount <= 10);
    ccEl.textContent = showCount ? p.cardCount + '张' : '';
    ccEl.className   = 'card-count-badge' + (showCount ? ' low' : '');
  }

  /* 面板边框：队伍色 + 出牌发光 */
  box.className = 'pbox ' + (dir==='h'?'pbox-top':'pbox-side') +
    ' ' + (p.team===1?'team1':'team2') + (isActive?' active':'') + (offline?' offline':'');
}

function renderCardBacks(el, count, dir){
  el.innerHTML = '';
  var max   = dir==='h' ? 10 : 7;
  var show  = Math.min(count||0, max);
  var cls   = dir==='h' ? 'cbk-h' : 'cbk-v';
  for(var i=0;i<show;i++){
    var d = document.createElement('div');
    d.className = cls;
    el.appendChild(d);
  }
}

/* 中央出牌区 */
function renderCenterPlay(lastPlay){
  var hint     = document.getElementById('play-hint');
  var leader   = document.getElementById('leader-badge');
