/* 飞牌动画：从屏幕下方(我方)飞向上方(对方) */
/* 供/还牌：正面高清牌从 fromSeat 飞向 toSeat，约3.5秒，全桌都看清牌型 */
var TRIBUTE_FLY_MS = 5000;   // 供/还贡飞牌动画时长(用户要求5秒，让全桌都能看清进贡/还供的是哪张牌)
function flyTributeCard(fromSeat, toSeat, code, labelTxt) {
  var fromEl = (typeof tbSeatEl==='function') ? tbSeatEl(fromSeat) : null;
  var toEl   = (typeof tbSeatEl==='function') ? tbSeatEl(toSeat)   : null;
  if (!fromEl || !toEl || !code) return;
  var fr = fromEl.getBoundingClientRect(), tr = toEl.getBoundingClientRect();
  if (!fr.width || !tr.width) return;
  var layer = document.getElementById('tribute-fly-layer');
  if (!layer) { layer = document.createElement('div'); layer.id = 'tribute-fly-layer';
    layer.style.cssText = 'position:fixed;inset:0;z-index:300;pointer-events:none;'; document.body.appendChild(layer); }
  var W = 66, H = 92;
  var fc = gdToLocal(fr.left + fr.width/2, fr.top + fr.height/2);   // 竖屏旋转换算
  var tc = gdToLocal(tr.left + tr.width/2, tr.top + tr.height/2);
  var x0 = fc.x - W/2, y0 = fc.y - H/2;
  var x1 = tc.x - W/2, y1 = tc.y - H/2;
  var el = document.createElement('div');
  el.style.cssText = 'position:fixed;left:0;top:0;width:'+W+'px;height:'+H+'px;border-radius:8px;overflow:hidden;'
    + 'box-shadow:0 10px 28px rgba(0,0,0,.6);z-index:301;'
    + 'transition:transform '+TRIBUTE_FLY_MS+'ms cubic-bezier(.34,.02,.28,1),opacity .35s ease;'
    + 'transform:translate('+x0+'px,'+y0+'px) scale(.55);';
  el.innerHTML = GDCard.faceSVG(code);
  layer.appendChild(el);
  if (labelTxt) {
    var lb = document.createElement('div');
    lb.textContent = labelTxt;
    lb.style.cssText = 'position:fixed;left:0;top:0;z-index:302;background:rgba(20,8,8,.9);color:#FFE066;'
      + 'font-size:.72rem;font-weight:800;padding:2px 8px;border-radius:8px;transition:transform '+TRIBUTE_FLY_MS+'ms cubic-bezier(.34,.02,.28,1),opacity .35s;'
      + 'transform:translate('+(x0+W/2-18)+'px,'+(y0-16)+'px);';
    layer.appendChild(lb);
    requestAnimationFrame(function(){ requestAnimationFrame(function(){
      lb.style.transform = 'translate('+(x1+W/2-18)+'px,'+(y1-16)+'px)';
    });});
    setTimeout(function(){ lb.style.opacity='0'; }, TRIBUTE_FLY_MS - 300);
    setTimeout(function(){ if (lb.parentNode) lb.parentNode.removeChild(lb); }, TRIBUTE_FLY_MS + 250);
  }
  requestAnimationFrame(function(){ requestAnimationFrame(function(){
    el.style.transform = 'translate('+x1+'px,'+y1+'px) scale(1.3)';   // 途中放大，牌面看得清
  });});
  setTimeout(function(){ el.style.opacity = '0'; }, TRIBUTE_FLY_MS - 300);
  setTimeout(function(){ if (el.parentNode) el.parentNode.removeChild(el); }, TRIBUTE_FLY_MS + 250);
}

function cardEmoji(code) {
  if (!code) return '—';
  if (code === 'BJ') return '🃏大王';
  if (code === 'LJ') return '🃏小王';
  var sym = {S:'♠',H:'♥',D:'♦',C:'♣'}[code[0]] || code[0];
  var rk  = code.slice(1) === 'T' ? '10' : code.slice(1);
  return sym + rk;
}

/* ════════════════════════════════════════════════
 * 六边形游戏区渲染
 * ════════════════════════════════════════════════ */

/* 六边形顶点位置（百分比，以 hex-board 为基准）
   座位排列（从我座位=1开始顺时针）：
   seat 1=bottom-center, 2=bottom-right, 3=top-right,
   4=top-center, 5=top-left, 6=bottom-left
*/
var HEX_POS = [
  null,                      // placeholder index 0
  { left:'50%', top:'82%' },  // seat 1 = bottom-center (me)
  { left:'82%', top:'62%' },  // seat 2 = bottom-right
  { left:'82%', top:'22%' },  // seat 3 = top-right
  { left:'50%', top:'5%'  },  // seat 4 = top-center
  { left:'18%', top:'22%' },  // seat 5 = top-left
  { left:'18%', top:'62%' },  // seat 6 = bottom-left
];

function init6pBoard(d) {
  levelTeam1 = d.levelTeam1 || 2;
  levelTeam2 = d.levelTeam2 || 2;
  winsTeam1  = d.winsTeam1 || 0;
  winsTeam2  = d.winsTeam2 || 0;
  aFail1     = d.aFail1 || 0;
  aFail2     = d.aFail2 || 0;
  updateCurrentLevel();
  document.getElementById('my-name-6p').textContent = MY_NAME_LS;
  document.getElementById('my-card-count-6p').textContent = fmtCount(myHand.length);
  document.getElementById('my-team-dot-6p').className = 'my-team-dot ' + (myTeam===1?'t1':'t2');

  /* 定位六个座位格：按我的实际 seat 偏移 */
  var total = 6;
  for (var i = 0; i < total; i++) {
    var displayIdx = i + 1; // 1..6: 相对于我的顺时针偏移
    var actualSeat = ((mySeat - 1 + i) % total) + 1;
    var el = document.getElementById('h-seat-' + actualSeat);
    if (!el) continue;
    var pos = HEX_POS[displayIdx];
    if (!pos) continue;
    el.style.left       = pos.left;
    el.style.top        = pos.top;
    el.style.transform  = 'translate(-50%,-50%)';
    el.dataset.displayIdx = displayIdx;
  }

  render6pPlayers(d.players, [], null);
  render6pHand(myHand);
  document.getElementById('action-hint-6p').textContent = '已连接，等待游戏开始...';
  syncButtons6p();
}

function render6pPlayers(pList, finOrder, turnSeat) {
  if (!pList || !pList.length) return;
  var total = 6;
  for (var i = 0; i < total; i++) {
    var actualSeat = ((mySeat - 1 + i) % total) + 1;
    var p        = pList.find(function(x){ return x.seat === actualSeat; });
    var el       = document.getElementById('h-seat-' + actualSeat);
    if (!el) continue;

    var finItem  = (finOrder||[]).find(function(f){ return f.seat === actualSeat; });
    var isActive = (turnSeat === actualSeat);
    var isMe     = p && p.isMe;
    var offline  = (connMap[actualSeat] === false) && !isMe;
    var label    = isMe ? (MY_NAME_LS || '我') : (p ? esc(p.name) : '等待...');
    if (offline) label += ' 📴';
    var teamCls  = p ? (p.team===1?'team1':'team2') : 'team2';

    /* 干净方框：昵称 + (打完显名次 / 剩≤10张报数)，去头像/队友字/牌背扇 */
    var infoHtml = '';
    if (finItem) {
      infoHtml = '<div class="h-finish-badge ' + (POS_CLASS[finItem.position]||'p3') + '">' +
        (POS_LABELS[finItem.position]||finItem.position+'游') + '</div>';
    } else if (p && (p.cardCount||0) <= 10) {
      infoHtml = '<span class="h-count low" style="font-size:.66rem;padding:1px 6px;border-radius:8px;">' + (p.cardCount||0) + '张</span>';
    }

    el.innerHTML =
      '<div class="h-pbox-name' + (offline?' offline':'') + '">' + label + (isMe?' (我)':'') + '</div>' +
      (infoHtml ? '<div class="h-pbox-info">' + infoHtml + '</div>' : '');
    el.className = 'h-pbox ' + teamCls + (isActive?' active':'') + (offline?' offline':'');
  }
}

function render6pCenter(lastPlay, turnSeat) {
  var center  = document.getElementById('hex-center');
  var hintEl  = document.getElementById('hex-hint');
  var trickEl = document.getElementById('hex-trick');
  var leadEl  = document.getElementById('hex-leader-badge');

  if (!lastPlay) {
    trickEl.innerHTML = '';
    leadEl.style.display = (isMyTurn && !hasLastPlay) ? 'block' : 'none';
    hintEl.textContent   = isMyTurn ? (hasLastPlay ? '' : '先出方') : '等待出牌';
  } else {
    leadEl.style.display = 'none';
    var cardsShown = (lastPlay.cards||[]).slice(0, 8);
    var cardsHtml  = cardsShown.map(function(c){ return miniCardHtml(c); }).join('');
    if (lastPlay.cards && lastPlay.cards.length > 8)
      cardsHtml += '<span style="font-size:.6rem;color:rgba(255,255,255,.4);">+' + (lastPlay.cards.length-8) + '</span>';
    trickEl.innerHTML = '<div style="font-size:.62rem;color:rgba(255,255,255,.5);margin-bottom:3px;">' +
      esc(lastPlay.name) + ' · ' + esc(lastPlay.label) + '</div>' +
      '<div style="display:flex;flex-wrap:wrap;justify-content:center;gap:2px;">' + cardsHtml + '</div>';
    hintEl.textContent = isMyTurn ? '需压过此牌' : '';
  }
}

function build6pCardEl(code, idx){
  var key  = code + '_' + idx;
  var isSel = selected.indexOf(key) >= 0;
  var card = document.createElement('div');
  card.className = 'hand-card hand-card-6p' + (isSel ? ' selected' : '');
  card.dataset.code = code; card.dataset.idx = idx;
  card.innerHTML = GDCard.faceSVG(code);              // 高清矢量牌面
  attachTap(card, (function(c, i){ return function(){ toggleCard6p(c, i); }; })(code, idx));
  return card;
}

/* 六人手牌：同点数竖排成列 */
function render6pHand(hand) {
  var scroll = document.getElementById('hand-scroll-6p');
  scroll.innerHTML = '';
  var curKey = null, colEl = null;
  hand.forEach(function(code, idx) {
    var k = rankKeyOf(code);
    if (k !== curKey) {
      colEl = document.createElement('div');
      colEl.className = 'hand-col';
      scroll.appendChild(colEl);
      curKey = k;
    }
    var card = build6pCardEl(code, idx);
    if (colEl.children.length > 0) card.classList.add('stacked');
    colEl.appendChild(card);
  });
}

function toggleCard6p(code, idx) {
  var key = code + '_' + idx;
  var i   = selected.indexOf(key);
  if (i >= 0) selected.splice(i, 1);
  else         selected.push(key);
  render6pHand(myHand);
  syncButtons6p();
  updateSelInfo6p();
  updatePlayButtonState();
}

function updateSelInfo6p() {
  var n = selected.length;
  document.getElementById('sel-info-6p').textContent    = n > 0 ? '· 已选' + n + '张' : '';
  document.getElementById('sel-info-6p').style.display  = n > 0 ? 'inline' : 'none';
  document.getElementById('btn-cancel-6p').style.display = n > 0 ? 'inline-block' : 'none';
  document.getElementById('btn-play-6p').textContent    = n > 0 ? '出牌(' + n + ')' : '出牌';
}

function syncButtons6p() {
  document.getElementById('btn-pass-6p').disabled = !isMyTurn || !hasLastPlay;
  updatePlayButtonState();
}
</script>

<!-- ══════════ 满屏锁定 + 按分辨率动态适配（各机型：苹果/安卓/华为等）══════════
     无论竖握横握，进入大屏即把牌桌锁成横向满屏；用真实像素精确计算，杜绝 dvw/dvh
     不支持机型的白边；首次触屏尝试进入全屏并锁定横向（安卓/华为支持，iOS 靠加桌面PWA全屏）。-->
<script>
(function(){
  var _deb;
  /* 用真实像素精确铺满：竖屏→旋转90°成横屏满屏；横屏→直接铺满 */
  function fitScreen(){
    var b = document.body; if(!b) return;
    /* 正在输入(聊天)时键盘弹出会改变可视高度，跳过重排避免牌桌抖动 */
    var ae = document.activeElement;
    if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA')) return;
    var w = Math.round(window.innerWidth), h = Math.round(window.innerHeight);
    b.style.position = 'fixed'; b.style.top = '0'; b.style.left = '0';
    b.style.transformOrigin = 'top left';
    if (h > w){   /* 竖握：整桌旋转成横屏 */
      b.style.width  = h + 'px';
      b.style.height = w + 'px';
      b.style.transform = 'translateX(' + w + 'px) rotate(90deg)';
    } else {      /* 横握：直接铺满，不旋转 */
      b.style.width  = w + 'px';
      b.style.height = h + 'px';
      b.style.transform = 'none';
    }
    /* 屏幕尺寸变了 → 手牌重新自适应，避免右侧溢出 */
    if (typeof window.fitHand === 'function') requestAnimationFrame(window.fitHand);
  }
  function schedule(){ clearTimeout(_deb); _deb = setTimeout(fitScreen, 60); }

  window.addEventListener('resize', schedule);
  window.addEventListener('orientationchange', function(){ schedule(); setTimeout(fitScreen, 350); });
  if (window.visualViewport) window.visualViewport.addEventListener('resize', schedule);
  window.addEventListener('load', function(){ fitScreen(); setTimeout(fitScreen, 300); });
  if (document.readyState !== 'loading') fitScreen();
  else document.addEventListener('DOMContentLoaded', fitScreen);

  /* 首次交互：尝试进入全屏并锁定横向（需用户手势；iOS 静默忽略，PWA 加桌面已是全屏）*/
  function goFsLock(){
    try {
      var el = document.documentElement;
      var req = el.requestFullscreen || el.webkitRequestFullscreen || el.mozRequestFullScreen || el.msRequestFullscreen;
      var lockLandscape = function(){
        try { if (screen.orientation && screen.orientation.lock) screen.orientation.lock('landscape')['catch'](function(){}); } catch(_){}
      };
      if (req && !(document.fullscreenElement || document.webkitFullscreenElement)) {
        var p = req.call(el);
        if (p && p.then) p.then(lockLandscape)['catch'](lockLandscape); else lockLandscape();
      } else {
        lockLandscape();
      }
    } catch(_){}
    setTimeout(fitScreen, 200);
  }
  var _once = function(){
    goFsLock();
    document.removeEventListener('touchend', _once);
    document.removeEventListener('click', _once);
  };
  document.addEventListener('touchend', _once, { passive: true });
  document.addEventListener('click', _once);
})();
</script>
</body>
</html>
