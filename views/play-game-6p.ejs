  var row = document.createElement('div'); row.className = 'cem-row';
  var inp = document.createElement('input'); inp.type = 'text'; inp.maxLength = 20; inp.value = val || '';
  var del = document.createElement('button'); del.type = 'button'; del.className = 'cem-del'; del.textContent = '✕';
  del.onclick = function(){ row.remove(); };
  row.appendChild(inp); row.appendChild(del);
