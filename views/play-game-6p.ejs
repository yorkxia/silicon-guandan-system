<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>掼蛋 · <%= roomCode %></title>
  <link rel="stylesheet" href="/css/style.css">
  <%- include('partials/pwa-head') %>
  <script>
  /* ── 全端满屏兜底：按真实视口(innerWidth/innerHeight)注入 --app-w/--app-h，
     不依赖 dvh/dvw 支持 → 微信/华为/OPPO/小米/安卓/苹果一致铺满整屏；
     输入框聚焦(键盘弹出)时不重算，避免牌桌被压缩 ── */
  (function(){
    var root = document.documentElement;
    /* ⚠️ 原则性修复：要不要旋转("是否竖屏")以前交给 CSS 的 @media(orientation:portrait)
       自己判断，跟这里注入 --app-w/--app-h 尺寸是两套完全独立、各自触发的机制——浏览器原生
       媒体查询的重新求值时机由浏览器自己决定，不受我们控制，正常情况下和 resize 事件差不多
       同步，但个别定制 WebView(华为鸿蒙4.2 等)在系统级浮层(如微信通话悬浮窗)改变可视区域时，
       媒体查询已经按新尺寸重新判定了"旋转/不旋转"，但 --app-w/--app-h 这两个自定义属性的更新
       事件(resize/visualViewport等)却还没触发或被吞掉——旋转状态和尺寸状态短暂"对不上"，
       会导致 body 的实际渲染框和触摸事件坐标系整体错位，出现"什么都点不中"（六人这里出过，
       四人从来没用过媒体查询、一直是用 JS 一次性把旋转和尺寸算在一起设，天然不会有这个不同步
       窗口，这正是本次要对齐的地方）。现在把"是否旋转"也放进这个函数里，跟尺寸同一次算、
       同一次写，浏览器只会看到一次样式变化，不会有旧尺寸配新状态/新尺寸配旧状态的中间态。 */
    function fit(){
      var ae = document.activeElement;
      if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA')) return;
      root.style.setProperty('--app-w', window.innerWidth  + 'px');
      root.style.setProperty('--app-h', window.innerHeight + 'px');
      root.classList.toggle('gd-portrait', window.innerHeight > window.innerWidth);
    }
    fit();
    window.addEventListener('resize', fit);
    window.addEventListener('pageshow', fit);
    window.addEventListener('orientationchange', function(){ setTimeout(fit,60); setTimeout(fit,300); });
    document.addEventListener('DOMContentLoaded', fit);
    /* 兜底：安卓系（华为/小米/OPPO/vivo 自带浏览器）地址栏收起展开、横竖屏切换时经常不触发
       （或严重延迟触发）resize/orientationchange，导致 --app-w/--app-h 卡在错误值上——
       整个旋转后的舞台尺寸全靠这两个变量撑起来，一旦卡死，中心倒计时圆盘/指针、不出出牌
       按钮全部继承这个错误位置，且没有任何东西会再次触发 fit() 去纠正。
       visualViewport 是安卓/iOS 都支持的更可靠的真实视口变化信号；ResizeObserver 直接监听
       html 元素的渲染尺寸变化，只要真实视口变了就必然触发，不依赖任何事件是否被正确派发。
       两者都只是新增触发时机，fit() 本身逻辑不变，不会影响已经工作正常的设备。 */
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', fit);
      window.visualViewport.addEventListener('scroll', fit);
    }
    if (typeof ResizeObserver === 'function') {
      new ResizeObserver(fit).observe(root);
    }
  })();
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; overflow: hidden; height: var(--app-h, 100dvh); }
    body {
      /* 硅谷海滩实景背景 */
      background: #0a7d73;   /* 赛事桌布：整屏纯平青绿毡面 */
      display: flex; flex-direction: column;
      font-family: -apple-system, "PingFang SC", sans-serif;
      width: var(--app-w, 100vw); height: var(--app-h, 100dvh);   /* 满屏：--app-w/h 由 JS 按真实视口注入，dvh 兜底 */
    }
    /* 牌桌改为整屏纯平青绿毡面（去除椭圆桌与上下阴影，桌面平整光滑）*/
    #beach-table { display: none; }
    body.mode-6p #beach-table { top: 52%; width: 98vw; height: 76vh; max-width: 1380px; }

    /* 微信/QQ等内置浏览器提示条：position:fixed 的元素，只要祖先(body)有 transform，
       就会以该祖先的旋转后的框为基准定位——跟 #exit-btn/#combo-bar 等既有元素同一套原理，
       不用再手算竖屏旋转坐标 */
    /* ⚠️ 原则性修复：早期版本 right:0(通顶到最右)，跟 #exit-btn/#support-btn(z-index:200，
       右上角固定按钮)在本地坐标上是重叠的——本条 z-index:99999 更高，会整块盖住二者的点击
       区域，导致"退出"点了没反应。右侧留 120px 让开这两个圆钮，和 #top-bar 的既有做法
       一致(#top-bar 也是 padding-right:120px 出于同一个理由)。另加 max-height+overflow:hidden
       兜底，即使文案在极窄机型上换行也不会意外把可点击范围撑得更高更大。 */
    #inapp-fs-guide {
      display: none; position: fixed; top: 0; left: 0; right: 120px; z-index: 99999;
      align-items: center; gap: 10px; padding: 8px 14px; max-height: 60px; overflow: hidden;
      background: linear-gradient(135deg,#2C0A0A,#1a0505); color: #fff;
      font-size: .74rem; line-height: 1.5; box-shadow: 0 3px 10px rgba(0,0,0,.4);
    }
    #inapp-fs-guide span { flex: 1; }
    #inapp-fs-guide b { color: #FFE066; }
    #inapp-fs-guide button {
      flex-shrink: 0; background: rgba(255,255,255,.15); border: none; color: #fff;
      width: 22px; height: 22px; border-radius: 50%; font-size: .8rem; cursor: pointer;
    }

    /* 竖屏 → 整个牌桌自动旋转成横屏满屏（微信内置浏览器无法锁定方向，用CSS旋转）*/
    #rotate-hint { display: none !important; }   /* 不再提示横屏，改为自动旋转 */
    /* 用 JS 写的 html.gd-portrait 类代替 @media(orientation:portrait)——原因见上面 fit() 里的
       长注释：类和 --app-w/--app-h 由同一次 fit() 调用一起写，不会出现"旋转状态"和"尺寸状态"
       各自独立触发、短暂互相对不上的中间态。 */
    html.gd-portrait { overflow: hidden; }
    html.gd-portrait body {
      overflow: hidden;
      position: fixed; top: 0; left: 0;
      width: var(--app-h, 100dvh);    /* 旋转后：宽=屏高（长边），--app-h 为真实视口高 */
      height: var(--app-w, 100dvw);   /* 旋转后：高=屏宽（短边），--app-w 为真实视口宽 */
      transform-origin: top left;
      transform: translateX(var(--app-w, 100dvw)) rotate(90deg);   /* 真满屏，不依赖 dvw 支持 */
    }

    /* ═══════════════ 顶部状态栏 ═══════════════ */
    #top-bar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 4px 120px 4px 12px; gap: 8px;   /* 右侧留 120px 让开客服+退出两个圆钮，避免遮住房间号 */
      background: transparent; flex-shrink: 0; z-index: 10;   /* 顶带透明，露出青绿毡面 */
    }

    /* 右上角圆形「退出比赛」开关：玩家可随时自行退出 */
    #exit-btn {
      position: fixed; top: 6px; right: 6px; z-index: 200;
      width: 32px; height: 32px; border-radius: 50%; padding: 0;
      border: 1.5px solid rgba(255,255,255,.55); cursor: pointer;
      background: rgba(192,0,15,.9); color: #fff; font-size: 17px; font-weight: 900; line-height: 1;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 2px 9px rgba(0,0,0,.5); -webkit-tap-highlight-color: transparent;
      transition: transform .1s;
    }
    #exit-btn:active { transform: scale(.88); }
    /* 浏览器标签页直开(未装桌面图标)：地址栏/手势条不像已装PWA那样固定，
       右上角按钮离物理边缘再远一点，降低被浏览器自身UI遮住或误触的概率 */
    body.gd-browser-mode #exit-btn,
    body.gd-browser-mode #support-btn { top: 16px; }

    /* 右上角「客服」按钮：置于退出圆钮左侧，与网上赛事管理员对话 */
    #support-btn {
      position: fixed; top: 6px; right: 44px; z-index: 200;
      height: 32px; padding: 0 12px; border-radius: 16px;
      border: 1.5px solid rgba(255,255,255,.55); cursor: pointer;
      background: rgba(15,158,69,.92); color: #fff; font-size: 13px; font-weight: 800; line-height: 1;
      display: flex; align-items: center; gap: 4px;
      box-shadow: 0 2px 9px rgba(0,0,0,.5); -webkit-tap-highlight-color: transparent;
      transition: transform .1s;
    }
    #support-btn:active { transform: scale(.9); }
    #support-btn .sb-dot {                 /* 客服有新回复时的红点 */
      display: none; width: 8px; height: 8px; border-radius: 50%;
      background: #ff3b30; box-shadow: 0 0 0 1.5px #fff;
    }
    #support-btn.has-unread .sb-dot { display: inline-block; }

    /* 客服对话浮层（与计分器同款；随大屏一起旋转，落在牌桌正上方）*/
    #kf-overlay { display: none; position: fixed; inset: 0; z-index: 100000; background: rgba(0,0,0,.55);
      align-items: center; justify-content: center; padding: 16px; }
    #kf-overlay.open { display: flex; }
    #kf-box { background: #fff; width: 100%; max-width: 440px; height: 82vh; max-height: 440px; border-radius: 16px;
      display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,.5); }
    #kf-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px;
      background: linear-gradient(135deg,#0f9e45,#0a7d38); color: #fff; font-weight: 800; font-size: .95rem; flex-shrink: 0; }
    #kf-close { cursor: pointer; font-size: 1.2rem; line-height: 1; padding: 0 4px; }
    #kf-msgs { flex: 1; overflow-y: auto; padding: 14px; background: #f4f6f8; display: flex; flex-direction: column; gap: 8px; }
    .kf-tip { background: #fff; border: 1px dashed #cbd5e1; color: #64748b; font-size: .8rem; border-radius: 10px; padding: 10px 12px; text-align: center; }
    .kf-msg { max-width: 80%; padding: 9px 13px; border-radius: 14px; font-size: .9rem; line-height: 1.4; word-break: break-word; white-space: pre-wrap; }
    .kf-user { align-self: flex-end; background: #25c05a; color: #fff; border-bottom-right-radius: 4px; }
    .kf-admin { align-self: flex-start; background: #fff; color: #1a1a2e; border: 1px solid #e2e8f0; border-bottom-left-radius: 4px; }
    .kf-who { display: block; font-size: .68rem; opacity: .7; margin-bottom: 2px; }
    #kf-input-row { display: flex; gap: 8px; padding: 10px 12px; border-top: 1px solid #e5e7eb; background: #fff; flex-shrink: 0; }
    #kf-input { flex: 1; min-width: 0; border: 1px solid #cbd5e1; border-radius: 20px; padding: 10px 14px; font-size: .92rem; outline: none; }
    #kf-send { border: none; border-radius: 20px; padding: 0 18px; background: #0f9e45; color: #fff; font-weight: 800; font-size: .9rem; cursor: pointer; }
    /* 左上：我方/对方 级牌+胜局（红蓝）；房间号右置 */
    .side-panel {
      display: flex; flex-direction: column; gap: 1.5px;
      background: rgba(0,0,0,.42); border: 1px solid rgba(255,255,255,.15);
      border-radius: 6px; padding: 3px 7px;
    }
    .side-row { display: flex; align-items: center; gap: 5.5px; font-size: .62rem; font-weight: 800; white-space: nowrap; }
    .side-lbl { letter-spacing: 1px; }
    .side-lv  { font-size: .88rem; font-weight: 900; min-width: 12px; text-align: center; }
    /* A级冲关次数：A1/A2/A3——原来用 <sup> 角标(0.5em)在赛事大屏上太小几乎看不清，
       改成同一行内的醒目小徽章，一眼就能看出这是第几次冲A */
    .side-lv-attempt {
      font-size: .62rem; font-weight: 900; margin-left: 2px; padding: 0 4px;
      border-radius: 5px; background: rgba(255,255,255,.28); vertical-align: middle;
    }
    .side-win { font-size: .58rem; font-weight: 900; opacity: 1; letter-spacing: .5px; }
    .side-win b { font-size: .72rem; }
    .side-row.red  { color: #FF3030; }  .side-row.red  .side-lv { color: #FF3030; }
    .side-row.blue { color: #2D7FFF; }  .side-row.blue .side-lv { color: #2D7FFF; }
    .tb-spacer { flex: 1; }
    .room-box  { font-size: .5rem; color: rgba(255,255,255,.5); letter-spacing: 1px; white-space: nowrap; }
    .room-code-sm { font-size: .66rem; font-weight: 900; color: #FFE066; letter-spacing: 2px; }

    /* ═══════════════ 对家区域（上方） ═══════════════ */
    #zone-top {
      flex: 1 1 0; min-width: 0; display: flex; justify-content: center; align-items: center;
      padding: 0;
    }
    /* 对家在顶栏内需紧凑：隐藏牌背、缩小内边距 */
    #top-bar .pbox-top { padding: 2px 10px; gap: 2px; }
    #top-bar .pbox-top .card-fan-h { display: none; }

    /* ═══════════════ 中央三列（左玩家 | 桌面 | 右玩家） ═══════════════ */
    #zone-mid {
      flex: 1; display: flex; align-items: stretch; min-height: 0;
      padding: 0 6px;
    }
    #zone-left, #zone-right {
      flex-shrink: 0; width: 64px; display: flex; align-items: center; justify-content: center;
    }
    #zone-center {
      flex: 1; display: flex; align-items: center; justify-content: center; position: relative;
    }

    /* ═══════════════ 玩家信息面板（通用） ═══════════════ */
    .pbox {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      border-radius: 12px; padding: 6px 8px;
      border: 2px solid rgba(255,255,255,0.06);
      background: rgba(0,0,0,0.3);
      transition: border-color .3s, box-shadow .3s;
      min-width: 0;
    }
    .pbox.team1 { border-color: rgba(255,59,78,.6); }
    .pbox.team2 { border-color: rgba(59,155,255,.6); }
    /* 出牌中：发光边框 + 脉冲 */
    .pbox.active {
      border-color: #FFE066 !important;
      box-shadow: 0 0 0 2px rgba(212,172,13,.25);
      animation: pulse-border 1.4s ease-in-out infinite;
    }
    @keyframes pulse-border {
      0%, 100% { box-shadow: 0 0 0 2px rgba(212,172,13,.25); }
      50%       { box-shadow: 0 0 0 6px rgba(212,172,13,.05); }
    }

    /* 头像圆圈 */
    .pbox-avatar {
      width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: .72rem; font-weight: 900; color: #fff; letter-spacing: 0;
    }
    .pbox-avatar.team1 { background: linear-gradient(135deg,#FF3B4E,#E00016); }
    .pbox-avatar.team2 { background: linear-gradient(135deg,#3B9BFF,#0A5BE0); }
    .pbox-avatar.active { background: #D4AC0D; color: #1a1a2e; }

    /* 名字 */
    .pbox-name {
      font-size: .64rem; color: rgba(255,255,255,.65); text-align: center; letter-spacing: 1px;
      max-width: 70px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .pbox-name.active { color: #FFE066; font-weight: 700; }
    .pbox-name.offline { color: rgba(255,120,120,.75); font-style: italic; }
    .h-pbox-name.offline { color: rgba(255,120,120,.75); font-style: italic; }
    /* 托管(掉线)座位：头像/标志变暗，示意已由 AI 接管 */
    .pbox-avatar.offline, .h-pbox-avatar.offline { filter: grayscale(.85) brightness(.6); opacity: .5; }
    /* 机器人托管：整格由鲜艳变灰暗，一眼看清哪些位置是机器人 */
    .pbox.offline   { filter: grayscale(1) brightness(.72); opacity: .8; border-color: rgba(150,150,150,.35) !important; }
    .h-pbox.offline { filter: grayscale(1) brightness(.72); opacity: .8; }
    .pbox-avatar.waiting-empty, .h-pbox-avatar.waiting-empty {
      opacity: .4; border-style: dashed !important;
    }
    .pbox.waiting-empty { opacity: .7; }

    /* 队友标签 */
    .buddy-tag {
      font-size: .55rem; padding: 1px 5px; border-radius: 5px; font-weight: 700; letter-spacing: 1px;
      background: rgba(212,172,13,.2); color: #D4AC0D; border: 1px solid rgba(212,172,13,.3);
    }
    /* 队友标签移到方块底部：作为 pbox（flex列）最后一个子元素，居中贴底 */
    .buddy-tag-bottom { align-self: center; margin-top: 2px; }
    /* 顶部对家：名字完整显示（加宽、不再截断）*/
    #top-bar .pbox-top .pbox-name,
    .pbox-top .pbox-name { max-width: 180px; }
    /* 六边形座位：队友标志移到该格最底部 */
    .h-buddy-tag.h-buddy-bottom { margin-top: 2px; }

    /* 牌数徽章 */
    .card-count-badge {
      font-size: .62rem; font-weight: 700; padding: 1px 6px; border-radius: 8px;
      background: rgba(255,255,255,.1); color: rgba(255,255,255,.7);
      border: 1px solid rgba(255,255,255,.12);
    }
    /* 剩牌 ≤10 张：高亮真实牌数 */
    .card-count-badge.low, .h-count.low {
      background: rgba(230,50,50,.92); color: #fff; border-color: #fff;
      font-size: .72rem; font-weight: 900; box-shadow: 0 0 6px rgba(230,50,50,.5);
    }

    /* 完成位置 */
    .finish-badge {
      font-size: .84rem; font-weight: 900; padding: 3px 12px; border-radius: 10px; letter-spacing: 1.5px;
      box-shadow: 0 2px 9px rgba(0,0,0,.45); border: 1px solid rgba(255,255,255,.25); white-space: nowrap;
    }
    .finish-badge.p1 { background:#F2C230; color:#1a1a2e; box-shadow:0 0 13px rgba(242,194,48,.75); border-color:#FFE066; }
    .finish-badge.p2 { background:#DCE3EE; color:#1a1a2e; }
    .finish-badge.p3 { background:#C98F53; color:#241606; }
    .finish-badge.p4 { background:#C0000F; color:#fff; }

    /* ─── 顶部玩家水平牌背 ─── */
    .pbox-top {
      max-width: min(260px, 78vw);
    }
    .card-fan-h {
      display: flex; justify-content: center; flex-wrap: nowrap; overflow: hidden;
    }
    .cbk-h {
      width: 20px; height: 30px; border-radius: 4px; flex-shrink: 0;
      background: linear-gradient(145deg, #9E0010, #C0000F, #7a000c);
      border: 1px solid rgba(255,255,255,.18);
      box-shadow: 1px 1px 3px rgba(0,0,0,.5), inset 0 0 0 1px rgba(255,255,255,.06);
      margin-left: -6px; position: relative; overflow: hidden;
    }
    .cbk-h::after {
      content: ''; position: absolute; inset: 2px; border-radius: 2px;
      border: 1px solid rgba(255,255,255,.1);
      background: repeating-linear-gradient(
        45deg, transparent 0, transparent 3px, rgba(255,255,255,.03) 3px, rgba(255,255,255,.03) 4px
      );
    }
    .cbk-h:first-child { margin-left: 0; }

    /* ─── 侧边玩家竖直牌背 ─── */
    .pbox-side { width: 60px; min-height: 96px; justify-content: center; }
    .card-fan-v {
      display: flex; flex-direction: column; align-items: center;
      min-height: 20px;
    }
    .cbk-v {
      width: 32px; height: 20px; border-radius: 4px; flex-shrink: 0;
      background: linear-gradient(145deg, #9E0010, #C0000F, #7a000c);
      border: 1px solid rgba(255,255,255,.18);
      box-shadow: 1px 1px 3px rgba(0,0,0,.5), inset 0 0 0 1px rgba(255,255,255,.06);
      margin-top: -7px; position: relative; overflow: hidden;
    }
    .cbk-v::after {
      content: ''; position: absolute; inset: 2px; border-radius: 2px;
      border: 1px solid rgba(255,255,255,.1);
      background: repeating-linear-gradient(
        45deg, transparent 0, transparent 3px, rgba(255,255,255,.03) 3px, rgba(255,255,255,.03) 4px
      );
    }
    .cbk-v:first-child { margin-top: 0; }

    /* ═══════════════ 中央桌面 ═══════════════ */
    #table-felt {
      width: min(220px, 58vw); height: min(180px, 34vw);
      max-height: 190px;
      border-radius: 50%;
      background: radial-gradient(ellipse, rgba(255,255,255,.04) 0%, transparent 70%);
      border: 1px solid rgba(255,255,255,.07);
      display: flex; align-items: center; justify-content: center;
      position: relative; flex-direction: column; gap: 6px;
    }
    #leader-badge {
      display: none; font-size: .68rem; color: #FFE066; letter-spacing: 2px;
      font-weight: 700; text-align: center;
      background: rgba(212,172,13,.15); border-radius: 10px; padding: 3px 10px;
      border: 1px solid rgba(212,172,13,.3);
    }
    #play-hint { color: rgba(255,255,255,.55); font-size: .82rem; letter-spacing: 3px; text-align: center; font-weight: 700; text-shadow: 0 1px 3px rgba(0,0,0,.5); }
    .trick-who {
      font-size: .68rem; color: rgba(255,255,255,.7); letter-spacing: 1px; text-align: center;
      background: rgba(0,0,0,.35); border-radius: 8px; padding: 2px 9px;
    }
    .trick-cards { display: flex; justify-content: center; flex-wrap: wrap; gap: 2px; }
    .trick-cards.nowrap { flex-wrap: nowrap; }   /* 出牌≤5张：强制单行不换行 */
    /* #5 三带二(三带对)：上排三张 / 下排一对 */
    .tk-fh { display: flex; flex-direction: column; align-items: center; gap: 3px; }
    .tk-fh .tk-row { display: flex; gap: 2px; justify-content: center; }
    /* #5 三连对(姊妹对)：小→大三对横排，每对成组、组间留空 */
    .tk-pairs { display: flex; gap: 11px; justify-content: center; align-items: flex-end; }
    .tk-pair  { display: flex; gap: 2px; }

    /* 迷你牌面（中央出牌区） */
    /* 迷你牌面（中央出牌区）—— 高清矢量牌，放大便于适老 */
    .mc {
      width: 34px; height: 48px; border-radius: 5px; overflow: hidden;
      box-shadow: 1px 2px 5px rgba(0,0,0,.45); flex-shrink: 0; position: relative;
    }
    .mc svg { display: block; width: 100%; height: 100%; }
    .trick-more { font-size: .65rem; color: rgba(255,255,255,.45); }

    /* 出牌赢回动画 */
    #trick-won-flash {
      display: none; position: absolute; z-index: 5;
      color: #FFE066; font-size: .78rem; font-weight: 700; letter-spacing: 2px;
      background: rgba(0,0,0,.55); border-radius: 10px; padding: 4px 12px;
      white-space: nowrap; pointer-events: none;
    }
    .fade-up { animation: fadeUp 1.3s ease forwards; }
    @keyframes fadeUp {
      0%   { opacity: 1; transform: translateY(0); }
      100% { opacity: 0; transform: translateY(-24px); }
    }

    /* ═══════════════ 我的手牌区 ═══════════════ */
    #my-hand-area {
      flex-shrink: 0; background: rgba(0,0,0,.4);
      border-top: 1px solid rgba(255,255,255,.07);
      padding-bottom: env(safe-area-inset-bottom, 4px);
    }
    #my-info-row {
      display: flex; align-items: center; gap: 7px; padding: 2px 14px 1px;
    }
    .my-team-dot {
      width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
    }
    .my-team-dot.t1 { background: #FF2A3A; box-shadow: 0 0 6px #FF2A3A; }
    .my-team-dot.t2 { background: #1470FF; box-shadow: 0 0 6px #1470FF; }
    #my-name      { font-size: .78rem; color: #fff; font-weight: 700; letter-spacing: 1px; }
    #sel-info     { font-size: .7rem; color: #FFE066; letter-spacing: 1px; display: none; }
    #my-card-count { margin-left: auto; font-size: .65rem; color: rgba(255,255,255,.38); }
    #btn-cancel {
      font-size: .65rem; color: rgba(255,255,255,.45); background: none; border: none;
      padding: 2px 6px; cursor: pointer; letter-spacing: 1px;
      display: none;
    }
    #my-turn-badge {
      font-size: .62rem; font-weight: 700; padding: 2px 7px; border-radius: 8px;
      background: rgba(212,172,13,.2); color: #FFE066; border: 1px solid rgba(212,172,13,.3);
      display: none;
    }

    /* 手牌横向滚动 */
    #hand-scroll {
      overflow-x: auto; overflow-y: hidden; display: flex;
      padding: 4px 14px 6px;
      scrollbar-width: none; -ms-overflow-style: none;
    }
    #hand-scroll::-webkit-scrollbar { display: none; }

    /* 单张手牌 */
    /* 单张手牌（高清矢量牌面，较前缩小约15%；5:7 标准比例）*/
    .hand-card {
      flex-shrink: 0; width: 48px; height: 67px; border-radius: 6px; overflow: hidden;
      background: #fff; box-shadow: 2px 3px 8px rgba(0,0,0,.45);
      margin-left: -17px;
      cursor: pointer;
      transition: transform .12s ease, box-shadow .12s ease, outline .1s;
      position: relative; user-select: none; -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }
    .hand-card svg { display: block; width: 100%; height: 100%; pointer-events: none; }
    .hand-card.hand-card-6p { width: 40px; height: 55px; }
    .hand-card:first-child { margin-left: 0; }
    .hand-card.selected {
      transform: translateX(9px);
      box-shadow: -3px 5px 18px rgba(0,0,0,.55);
      outline: 3px solid #FF2626;      /* 点击过的牌用红框标记 */
      z-index: 30;
    }
    /* 锁定牌型：彩色环标记（--combo 由 JS 按组分配不同色）*/
    .hand-card.locked {
      box-shadow: 0 0 0 3px var(--combo, #FFD54A), 2px 3px 8px rgba(0,0,0,.45);
      border-color: var(--combo, #FFD54A);
    }
    .hand-card.locked.selected {
      transform: translateX(9px); z-index: 30;
      box-shadow: 0 0 0 3px var(--combo, #FFD54A), -3px 5px 18px rgba(0,0,0,.55);
      outline: 3px solid #FF2626;
    }
    /* 底部长条栏：左侧"我"的信息 + 右侧锁牌/重置/同花顺/顺子/发消息，同一水平线贴底
       （六人模式下 #my-info-6p 被搬进这里，与5个功能键对齐，把上面让给六边形牌桌区）*/
    #combo-bar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      display: flex; align-items: center; justify-content: space-between; gap: 8px;
      height: calc(38px + env(safe-area-inset-bottom, 0));
      padding: 0 9px env(safe-area-inset-bottom, 0) 10px;
      background: transparent;   /* 底带透明，露出青绿毡面 */
    }
    /* 浏览器标签页直开：底部手势条/工具栏不固定，锁牌/重置等按钮离物理底边再多留一点 */
    body.gd-browser-mode #combo-bar {
      height: calc(38px + env(safe-area-inset-bottom, 0) + 10px);
      padding-bottom: calc(env(safe-area-inset-bottom, 0) + 10px);
    }
    #combo-bar #my-info-6p { flex: 1 1 auto; min-width: 0; overflow: hidden; }
    #combo-bar .cb-pills { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    #combo-bar .cb-pill {        /* 较原尺寸放大25% */
      height: 29px; padding: 0 19px; border-radius: 14px; border: none; cursor: pointer;
      color: #fff; font-weight: 800; font-size: .79rem; letter-spacing: 2px;
      display: flex; align-items: center; box-shadow: 0 2px 7px rgba(0,0,0,.4);
      transition: transform .1s;
    }
    #combo-bar .cb-pill:active { transform: scale(.94); }
    #combo-bar .cb-lock  { background: linear-gradient(#ff7a7a, #D32029); }  /* 红=锁牌 */
    #combo-bar .cb-reset { background: linear-gradient(#ffd657, #F2B705); color: #6a4e00; }  /* 黄=重置 */
    #combo-bar .cb-flush { background: linear-gradient(#c99bff, #7B3FE4); }  /* 紫=同花顺(智能凑牌) */
    #combo-bar .cb-straight { background: linear-gradient(#ffc061, #E67E22); }  /* 橙=顺子(智能凑牌·可换头尾) */

    /* 发消息药丸（底栏最右）*/
    #chat-fab {                  /* 发消息键随六键一起再缩 25% */
      height: 24px; min-width: 35px; padding: 0 11px; border-radius: 11px; cursor: pointer;
      background: radial-gradient(circle at 34% 28%, #ffffff, #e7edf5);
      box-shadow: 0 2px 8px rgba(0,0,0,.4); border: none;
      display: flex; align-items: center; justify-content: center;
      color: #1E6BE5; font-size: .98rem; font-weight: 900; letter-spacing: 1px;
    }
    #chat-fab:active { transform: scale(.94); }
    #chat-backdrop { position: fixed; inset: 0; z-index: 294; display: none; background: transparent; }
    #chat-backdrop.open { display: block; }
    #chat-panel {
      position: fixed; right: 12px; bottom: 42px; z-index: 295; display: none;
      width: 268px; max-width: 82vw; background: rgba(22,26,34,.97);
      border: 1px solid rgba(255,255,255,.18); border-radius: 14px; padding: 10px;
      box-shadow: 0 8px 30px rgba(0,0,0,.6);
    }
    #chat-panel.open { display: block; }
    #chat-panel .cp-quick, #chat-panel .cp-emoji { display: flex; flex-wrap: wrap; gap: 6px; }
    #chat-panel .cp-quick { margin-bottom: 7px; }
    #chat-panel .cp-emoji { margin-bottom: 8px; }
    #chat-panel .cp-q {
      background: rgba(255,255,255,.1); color: #fff; border: 1px solid rgba(255,255,255,.18);
      border-radius: 9px; padding: 6px 10px; font-size: .8rem; cursor: pointer; font-weight: 600;
    }
    #chat-panel .cp-q:active { background: rgba(255,255,255,.24); }
    #chat-panel .cp-e { font-size: 1.3rem; cursor: pointer; line-height: 1; padding: 2px 3px; background: none; border: none; }
    #chat-panel .cp-foot-row { display: flex; justify-content: flex-end; }
    #chat-panel .cp-edit-btn {
      background: rgba(255,255,255,.08); color: rgba(255,255,255,.65); border: 1px solid rgba(255,255,255,.18);
      border-radius: 9px; padding: 5px 10px; font-size: .72rem; cursor: pointer;
    }
    /* 预设话术编辑弹窗（管理员账号密码验证）*/
    #chat-edit-overlay { position: fixed; inset: 0; z-index: 400; display: none;
      align-items: center; justify-content: center; padding: 20px; background: rgba(0,0,0,.6); }
    #chat-edit-overlay.open { display: flex; }
    #chat-edit-box { background: #fff; width: 100%; max-width: 340px; border-radius: 16px;
      padding: 20px 18px; box-shadow: 0 10px 40px rgba(0,0,0,.4); }
    .cem-title { font-size: 1rem; font-weight: 800; color: #1E6BE5; text-align: center; margin-bottom: 12px; }
    #chat-edit-box input[type=text], #chat-edit-box input[type=password] {
      width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 12px;
      font-size: .9rem; outline: none; margin-bottom: 10px; box-sizing: border-box;
    }
    .cem-err { min-height: 16px; font-size: .74rem; color: #e04040; margin-bottom: 6px; text-align: center; }
    .cem-btns { display: flex; gap: 10px; margin-top: 4px; }
    .cem-btns button { flex: 1; border: none; border-radius: 22px; padding: 10px 0;
      font-size: .88rem; font-weight: 800; cursor: pointer; }
    .cem-cancel { background: #eef1f4; color: #555; }
    .cem-ok { background: linear-gradient(135deg,#2E7BF5,#1E5BC5); color: #fff; }
    #cem-list { max-height: 260px; overflow-y: auto; margin-bottom: 10px; }
    .cem-row { display: flex; gap: 6px; margin-bottom: 7px; }
    .cem-row input { flex: 1; min-width: 0; margin-bottom: 0 !important; }
    .cem-del { flex-shrink: 0; width: 30px; border: none; border-radius: 8px; background: #fdecec;
      color: #e04040; font-weight: 800; cursor: pointer; }
    #cem-add { width: 100%; border: 1px dashed #9db6e0; border-radius: 10px; background: #f2f6fd;
      color: #1E6BE5; font-weight: 700; padding: 8px 0; cursor: pointer; margin-bottom: 6px; }
    .chat-bubble {
      position: fixed; transform: translate(-50%, -100%); z-index: 250;
      background: #fff; color: #1a1a2e; border-radius: 13px; padding: 6px 12px;
      font-size: .86rem; font-weight: 700; max-width: 46vw; white-space: normal;
      box-shadow: 0 4px 14px rgba(0,0,0,.4); pointer-events: none;
      animation: chatPop .2s ease;
    }
    .chat-bubble .cb-name { color: #1E6BE5; font-weight: 900; }
    .chat-bubble::after {
      content: ''; position: absolute; left: 22px; bottom: -7px;
      border: 7px solid transparent; border-top-color: #fff;
    }
    .chat-bubble.cb-toast::after { display: none; }   /* 顶部兜底提示不显示下箭头 */
    @keyframes chatPop { from { opacity: 0; transform: translate(-50%, -90%) scale(.8); } }

    /* ═══════════ 大屏内进贡：座位光标 + 手牌高亮（替代弹框）═══════════ */
    #tb-cursor-layer { position: fixed; inset: 0; z-index: 240; pointer-events: none; }
    .tb-cursor {
      position: fixed; transform: translate(-50%, -50%);
      padding: 4px 10px; border-radius: 13px; font-size: .78rem; font-weight: 900;
      letter-spacing: 1px; white-space: nowrap; box-shadow: 0 3px 12px rgba(0,0,0,.45);
      border: 2px solid rgba(255,255,255,.6);
    }
    .tb-cursor.give { background: #C0000F; color: #fff; border-color: #ff6b6b;
      animation: tbPulse 1s ease-in-out infinite; }
    .tb-cursor.wait { background: rgba(90,90,90,.92); color: rgba(255,255,255,.75); }
    .tb-cursor.ret  { background: #1E6BE5; color: #fff; border-color: #7ab6ff;
      animation: tbPulse 1s ease-in-out infinite; }
    @keyframes tbPulse { 0%,100%{ transform:translate(-50%,-50%) scale(1);} 50%{ transform:translate(-50%,-50%) scale(1.08);} }
    .hand-card.tb-cand  { box-shadow: 0 0 0 3px #FFD54A, 0 0 14px 3px rgba(255,213,74,.7); border-color:#FFD54A; }
    .hand-card.tb-retok { box-shadow: 0 0 0 3px #66D17A, 0 0 12px 2px rgba(102,209,122,.6); border-color:#66D17A; }
    .hand-card.tb-dim   { opacity: .4; }
    #tb-prompt {
      display: none; position: fixed; left: 50%; bottom: 92px; transform: translateX(-50%);
      z-index: 245; background: rgba(20,8,8,.92); color: #FFE066; border: 1px solid rgba(212,172,13,.6);
      padding: 7px 16px; border-radius: 12px; font-size: .85rem; font-weight: 800; letter-spacing: 1px;
      white-space: nowrap; box-shadow: 0 4px 16px rgba(0,0,0,.5);
    }

    /* 按点数竖排成列 */
    .hand-col {
      display: flex; flex-direction: column; align-items: flex-start;
      flex-shrink: 0; position: relative; margin-left: 7px;
    }
    .hand-col:first-child { margin-left: 0; }
    .hand-col .hand-card { margin-left: 0; }
    /* #3 锁定组竖叠列：整组一竖列相叠(只露角标)+彩色外框，固定在最左，与右侧散牌明显分隔 */
    .hand-col.combo-col {
      border: 2px solid var(--combo, #FFD54A); border-radius: 9px;
      padding: 3px; margin-right: 9px; background: rgba(255,255,255,.07); align-self: flex-end;
    }
    .hand-col .hand-card.stacked { margin-top: -47px; }                /* 67-47=20px 露出角标 */
    body.mode-6p .hand-col .hand-card.stacked { margin-top: -39px; }   /* 55-39=16px 露出角标 */
    body.mode-6p .hand-col { margin-left: 2.25px; }
    #hand-scroll { align-items: flex-end; justify-content: center; }
    #hand-scroll-6p { align-items: flex-end; justify-content: center; }

    /* 点数 + 花色：花色 100% 在点数右侧同一行、不换行（放大，便于老年人辨认）*/
    .card-corner { display: flex; flex-direction: row; align-items: center; gap: 2.25px;
      line-height: 1; flex-wrap: nowrap; white-space: nowrap; }
    .card-top    { font-size: 1.5rem; font-weight: 900; line-height: 1; }
    .card-suit   { font-size: 1.4rem; line-height: 1; }
    /* 牌心大花色：彩色、醒目，竖排叠牌时也能透出花色（颜色继承本牌红/黑）*/
    .card-center {
      position: absolute; top: 56%; left: 50%; transform: translate(-50%,-50%);
      font-size: 3.4rem; opacity: .5; font-weight: 900;
    }
    .hand-card.joker-big   { background: #fff url('/img/joker-big.png')   center top / cover no-repeat; }
    .hand-card.joker-small { background: #fff url('/img/joker-small.png') center top / cover no-repeat; }
    .joker-label { display: none; }   /* 用真实王牌图片，不再显示文字 */

    /* 手牌区边缘渐隐提示有更多牌 */
    #hand-scroll-wrap { position: relative; }
    #hand-scroll-wrap::after {
      content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 28px;
      background: linear-gradient(to right, transparent, rgba(0,0,0,.4));
      pointer-events: none;
    }

    /* ═══════════════ 操作区（不出=中心左侧，出牌=中心右侧，避开对家出牌）═══════════════ */
    #action-bar {
      position: fixed; top: 14%; left: 0; right: 0; z-index: 55;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 calc(5vw + 92px);   /* 向中心各移约一个按钮长度，避免遮挡左上记分牌 */
      background: transparent; pointer-events: none;
    }
    #action-bar .action-btn { pointer-events: auto; }
    #action-hint { display: none; }   /* 提示已由中央倒计时/徽章体现，避免遮挡 */
    #action-hint.my-lead  { color: #80D880; }
    #action-hint.my-beat  { color: #FFE066; }
    /* 不出/出牌：整体尺寸仍比最初缩小约30%，但文字进一步放大更醒目 */
    .action-btn {
      padding: 9px 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,.55);
      font-size: .85rem; font-weight: 900; letter-spacing: 1.8px; cursor: pointer;
      transition: all .15s; white-space: nowrap;
      backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
    }
    /* 不出 = 蓝色玻璃 */
    .action-btn.pass {
      background: linear-gradient(180deg,rgba(143,208,247,.5) 0%,rgba(63,155,224,.5) 55%,rgba(44,130,198,.5) 100%); color: #fff;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 3px 9px rgba(0,60,120,.25);
      text-shadow: 0 1px 2px rgba(0,40,80,.55);
    }
    .action-btn.pass:hover:not(:disabled) { filter: brightness(1.08); transform: translateY(-1px); }
    .action-btn.pass:disabled {
      background: linear-gradient(180deg,rgba(204,204,204,.5),rgba(154,154,154,.5)); color: #eee;
      box-shadow: none; text-shadow: none; border-color: rgba(255,255,255,.3); cursor: default;
    }
    /* 出牌 = 绿色玻璃 */
    .action-btn.play {
      background: linear-gradient(180deg,rgba(139,224,106,.5) 0%,rgba(67,181,42,.5) 55%,rgba(47,148,24,.5) 100%); color: #fff;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 3px 10px rgba(20,110,0,.25);
      text-shadow: 0 1px 2px rgba(0,60,0,.5);
    }
    .action-btn.play:hover:not(:disabled) { filter: brightness(1.08); transform: translateY(-2px); }
    .action-btn.play:disabled {
      background: linear-gradient(180deg,rgba(204,204,204,.5),rgba(154,154,154,.5)); color: #eee;
      box-shadow: none; text-shadow: none; border-color: rgba(255,255,255,.3); cursor: default;
    }
    /* 选牌无效/压不过：出牌按钮变红 */
    .action-btn.play.invalid:not(:disabled) {
      background: linear-gradient(180deg,rgba(255,154,154,.5) 0%,rgba(227,48,48,.5) 55%,rgba(192,24,24,.5) 100%);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.35), 0 3px 10px rgba(180,0,0,.3);
      text-shadow: 0 1px 2px rgba(80,0,0,.5);
    }
    /* 各家出的牌贴其座位显示 */
    .seat-play {
      position: fixed; transform: translate(-50%,-50%); z-index: 42;
      display: flex; gap: 1px; pointer-events: none; align-items: center;
      flex-wrap: wrap; justify-content: center; max-width: 42vw;
    }
    .sp-pass {
      background: rgba(214,150,20,.95); color: #fff; font-weight: 900;
      padding: 2px 12px; border-radius: 12px; font-size: 15px; letter-spacing: 2px;
      box-shadow: 0 2px 8px rgba(0,0,0,.4);
    }
    .sp-more { color: #fff; font-size: 11px; margin-left: 3px; align-self: center; text-shadow: 0 1px 2px #000; }
    /* 出牌统一展示：从小到大，每行固定最多6张(不依赖容器宽度自动换行的flex-wrap，
       保证任何屏幕上"一排6张"都是同一个数字) */
    .pc-rows { display: flex; flex-direction: column; align-items: center; gap: 2px; }
    .pc-row  { display: flex; gap: 2px; justify-content: center; }
    /* 出牌结构化分列：同点数一列竖叠(牌同点，重叠不丢信息)，列按点数升序左→右，视觉对等平衡 */
    .sp-cols { display: flex; align-items: flex-start; justify-content: center; gap: 4px; }
    .sp-col  { display: flex; flex-direction: column; align-items: center; }
    .sp-col .mc { margin-top: -26px; }          /* 竖向重叠：露出每张顶部约22px */
    .sp-col .mc:first-child { margin-top: 0; }
    .sp-colmore { font-size: 10px; color: #fff; font-weight: 900; text-shadow: 0 1px 2px #000; margin-top: 1px; }
    /* 出牌改为贴座位，中央不再重复 */
    #trick-area, #hex-trick { display: none !important; }

    /* 操作无效提示 toast */
    #err-toast {
      position: fixed; bottom: 110px; left: 50%; transform: translateX(-50%);
      background: rgba(192,0,15,.92); color: #fff; font-size: .8rem; font-weight: 700;
      padding: 8px 18px; border-radius: 20px; z-index: 60;
      display: none; letter-spacing: 1px; white-space: nowrap;
      box-shadow: 0 4px 16px rgba(0,0,0,.4);
    }

    /* ═══════════════ 加载层 ═══════════════ */
    #loading-overlay {
      position: fixed; inset: 0; z-index: 100;
      background: radial-gradient(ellipse,#1a4a1a,#061a06);
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    }
    #loading-overlay .spin { font-size: 2.4rem; animation: spin 1.1s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    #loading-overlay p { color: rgba(255,255,255,.55); font-size: .88rem; letter-spacing: 2px; }

    /* ═══════════════ 错误层 ═══════════════ */
    #err-box {
      display: none; position: fixed; inset: 0; z-index: 200;
      background: rgba(0,0,0,.88); align-items: center; justify-content: center;
    }
    #err-box .err-inner {
      background: #1a0505; border: 1px solid rgba(192,0,15,.4); border-radius: 18px;
      padding: 30px 26px; text-align: center; max-width: 320px;
    }
    #err-box p { color: #F08080; margin: 0 0 18px; font-size: .9rem; line-height: 1.6; }
    #err-box a { color: #FFE066; font-size: .84rem; }

    /* ═══════════════ 结算层 ═══════════════ */
    #result-overlay {
      display: none; position: fixed; inset: 0; z-index: 300;
      background: rgba(0,0,0,.93); flex-direction: column; align-items: center; justify-content: center;
      overflow-y: auto; padding: 16px 0;
    }
    .result-wrap {
      max-width: 340px; width: 90%; text-align: center;
      background: rgba(255,255,255,.04); border-radius: 22px; padding: 24px 26px 22px;
      border: 1px solid rgba(212,172,13,.22);
      max-height: calc(100vh - 32px); display: flex; flex-direction: column; overflow: hidden;
    }
    .result-type { font-size: 3rem; font-weight: 900; letter-spacing: 6px; margin-bottom: 4px; }
    .result-type.win  { color: #FFE066; text-shadow: 0 0 28px rgba(212,172,13,.6); }
    .result-type.lose { color: #80A8E8; }
    .result-level-line {
      font-size: .82rem; color: rgba(255,255,255,.5); letter-spacing: 1px; margin-bottom: 18px;
    }
    .result-level-line strong { color: #FFE066; }
    .result-order { display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px;
      overflow-y: auto; min-height: 0; flex: 1 1 auto; }
    .result-row {
      display: flex; align-items: center; gap: 10px;
      background: rgba(255,255,255,.05); border-radius: 9px; padding: 8px 13px;
      border: 1px solid rgba(255,255,255,.07);
    }
    .result-pos { font-size: .7rem; font-weight: 700; width: 34px; flex-shrink: 0; }
    .result-pos.p1 { color: #D4AC0D; }
    .result-pos.p2 { color: #bbb; }
    .result-pos.p3 { color: #777; }
    .result-pos.p4 { color: #F08080; }
    .result-pname { flex: 1; font-size: .88rem; color: #fff; font-weight: 700; text-align: left; }
    .result-team-tag { font-size: .68rem; color: rgba(255,255,255,.38); }
    .result-btns { display: flex; gap: 8px; flex-shrink: 0; }
    .result-btn {
      flex: 1; padding: 12px; border-radius: 11px; border: none; cursor: pointer;
      font-size: .88rem; font-weight: 900; letter-spacing: 2px; color: #fff;
    }
    .result-btn.primary {
      background: linear-gradient(135deg,#C0000F,#8B0000);
      box-shadow: 0 4px 14px rgba(192,0,15,.4);
    }
    .result-btn.secondary {
      background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18);
    }

    /* ═══════════════ 六人赛事 · 六边形布局 ═══════════════ */
    body.mode-6p #zone-top, body.mode-6p #zone-mid,
    body.mode-6p #my-hand-area, body.mode-6p #action-bar { display: none !important; }

    body.mode-6p #game-6p-board { display: flex !important; }
    body.mode-6p #action-bar-6p { display: flex !important; }   /* 默认隐藏，避免4人模式误显示；见下方 #action-bar-6p 基础样式 */

    #game-6p-board {
      display: none;
      flex-direction: column;
      flex: 1;
      min-height: 0;
      position: relative;
      overflow: hidden;
    }

    /* 六边形主板（玩家围坐）—— 放开到接近满屏，六家拉到最大间距；
       最小高度降低，把矮屏幕上有限的空间优先让给下面的手牌区/操作栏(否则会把手牌挤没) */
    #hex-board {
      position: relative;
      width: 100%;
      max-width: 1360px;
      margin: 0 auto;
      flex: 1;
      /* 竖屏旋转后本地高度预算=手机物理宽度，最窄机型也就 360px 左右，刨去顶栏(~64)和手牌区
         保底所需(~160，含给#combo-bar让出的空间)后所剩无几——缩到刚够中央桌面+座位格，
         确保连最窄机型也不会挤到溢出(否则手牌区会被下面 #combo-bar 盖住一截，见下方) */
      min-height: 130px;
    }

    /* 中央牌桌区：适度缩小，给手牌区腾出被 #combo-bar 占用的空间(见 #hex-board min-height 的注释) */
    #hex-center {
      position: absolute;
      left: 50%; top: 50%;
      transform: translate(-50%,-50%);
      width: 200px; height: 100px;
      background: #0a7d73;   /* 中央牌桌与毡面同色（去深绿） */
      border-radius: 50%;
      border: 2px solid rgba(212,172,13,.2);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      z-index: 5;
    }

    /* 六个座位格：绝对定位在六边形顶点。干净方框：昵称+(托管/剩余张数/头游，三选一动态)上下各占一半；
       昵称字号翻倍后适当加宽方框(55→72)避免英文名/长昵称被过度截断 */
    .h-pbox {
      position: absolute;
      width: 72px;
      min-height: 44px;
      display: flex; flex-direction: column; align-items: center; gap: 2px;
      z-index: 10;
      padding: 3px 4px; border-radius: 7px;
      border: 2px solid rgba(255,255,255,.06); background: rgba(0,0,0,.3);
      overflow: hidden;
      transition: border-color .3s, box-shadow .3s;
    }
    /* 本家/对家一目了然：红蓝底色区分(1/3/5号=一队红，2/4/6号=一队蓝)，不再只靠边框颜色 */
    .h-pbox.team1 { border-color: rgba(255,59,78,.75); background: rgba(255,59,78,.22); }
    .h-pbox.team2 { border-color: rgba(59,155,255,.75); background: rgba(59,155,255,.22); }
    /* 注意：不能复用 4 人版共享的 pulse-border 动画——它的 0%/100% 关键帧会用自己的
       box-shadow 值整段覆盖掉下面写的颜色，导致这里声明的亮黄色发光其实从未真正显示过。
       单独定义一套关键帧，并叠加暖黄底色，让"轮到谁出牌"在大屏上一眼就能看清。 */
    .h-pbox.active {
      border-color: #FFE066 !important;
      border-width: 3px;
      background: rgba(255,224,102,.3) !important;
      animation: pulse-border-6p-active 1s ease-in-out infinite;
    }
    @keyframes pulse-border-6p-active {
      0%, 100% { box-shadow: 0 0 16px 4px rgba(255,224,102,.8), 0 0 0 2px rgba(255,224,102,.5); }
      50%      { box-shadow: 0 0 30px 9px rgba(255,224,102,1),  0 0 0 3px rgba(255,224,102,.75); }
    }
    /* "我"这个座位在 hex 环内只作为出牌卡片的定位锚点(仍需真实尺寸供 getBoundingClientRect 取值)，
       不再画出方框——我的信息已合并到底部 #combo-bar，避免和出牌牌型抢位置/互相遮挡 */
    .h-pbox.h-me-anchor { opacity: 0; pointer-events: none; }
    /* 顶点位置（%值以 hex-board 宽高为基准，用 JS 动态设置）*/
    .h-pbox-avatar {
      width: 27px; height: 27px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: .6rem; font-weight: 900; color: #fff;
      transition: all .3s;
    }
    .h-pbox-avatar.team1 { background: linear-gradient(135deg,#FF3B4E,#E00016); }
    .h-pbox-avatar.team2 { background: linear-gradient(135deg,#3B9BFF,#0A5BE0); }
    .h-pbox-avatar.active { box-shadow: 0 0 0 3px #FFE066; animation: pulse-border 1.4s ease-in-out infinite; }
    .h-pbox-name { font-size: .82rem; color: #fff; font-weight: 900; text-align: center; max-width: 64px; line-height: 1.1; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex: 1 1 0; }
    .h-pbox.h-top-slot .h-pbox-name { -webkit-line-clamp: 1; max-width: 130px; }
    /* 下半区：动态徽章(托管/剩余张数/头游三选一)，没有徽章时留空，保持昵称与徽章各占一半高度 */
    .h-pbox-info { font-size: .38rem; color: rgba(255,255,255,.4); text-align: center; flex: 1 1 0; display: flex; align-items: center; justify-content: center; }
    .h-badge-afk {
      font-size: .68rem; font-weight: 900; padding: 1px 8px; border-radius: 8px;
      background: rgba(255,150,20,.92); color: #1a1a2e; border: 1px solid #fff;
      box-shadow: 0 0 6px rgba(255,150,20,.5); white-space: nowrap;
    }
    /* 顶部中央（对家）提到顶栏那一行：与左积分榜、右房号同一水平线，避免被顶栏框线切断 */
    .h-pbox.h-top-slot {
      position: fixed; top: 9px; left: 50%; transform: translateX(-50%);
      flex-direction: row; align-items: center; gap: 6px;
      width: auto; min-height: 0; z-index: 20;
    }
    /* 横排布局，不能被上面的上下均分规则拉伸 */
    .h-pbox.h-top-slot .h-pbox-name,
    .h-pbox.h-top-slot .h-pbox-info { flex: 0 0 auto; }
    .h-pbox.h-top-slot .h-pbox-avatar { width: 27px; height: 27px; font-size: .6rem; }   /* 与两侧方框头像同尺寸，避免顶部框看不清 */
    .h-pbox.h-top-slot .h-pbox-name   { max-width: 130px; }
    .h-pbox.h-top-slot .h-card-fan    { display: none; }
    .h-buddy-tag { font-size: .55rem; background: rgba(212,172,13,.25); color: #FFE066; border-radius: 6px; padding: 1px 5px; }
    .h-card-fan { display: flex; gap: -4px; }
    .h-cbk { width: 14px; height: 20px; background: #1a3a6e; border-radius: 2px; border: 1px solid rgba(255,255,255,.2); margin: 0 -2px; }
    .h-finish-badge { font-size: .85rem; font-weight: 900; border-radius: 10px; padding: 3px 12px; letter-spacing: 1px;
      box-shadow: 0 2px 8px rgba(0,0,0,.45); border: 1px solid rgba(255,255,255,.25); white-space: nowrap; }
    .h-finish-badge.p1 { background: #F2C230; color: #1a1a2e; box-shadow: 0 0 13px rgba(242,194,48,.75); border-color:#FFE066; }
    .h-finish-badge.p2 { background: #DCE3EE; color: #1a1a2e; }
    .h-finish-badge.p3 { background: #C98F53; color: #241606; }
    .h-finish-badge.p4 { background: #C0000F; color: #fff; }

    /* 六人手牌区：flex-shrink:0 强制保底，绝不能被中间牌桌区挤压到看不见(核心出牌功能)
       "我"的信息行已搬到 #combo-bar 与功能键同排贴底，这里只剩手牌横滑区。
       #combo-bar 是 position:fixed、贴在本地最底部、z-index 更高的独立元素，跟手牌牌尾
       占的是同一块屏幕区域——只要 #hex-board 没有因为空间不够被压到 min-height 溢出，
       这里的 padding-bottom 就直接等于牌区末尾到 #combo-bar 之间的净空隙(与机型宽度无关)，
       50px > #combo-bar 实际高度(38px+安全区)，留够余量不被盖住 */
    #my-hand-6p {
      padding: 2px 0 50px;
      background: transparent; flex-shrink: 0;   /* 底带透明，露出青绿毡面 */
    }
    #my-info-6p {
      display: flex; align-items: center; gap: 8px; padding: 1px 4px;
      font-size: .78rem; white-space: nowrap;
    }
    #my-hand-scroll-6p { overflow-x: auto; padding: 4px 8px 8px; }

    /* 六人不出/出牌：脱离 flex 流，不再和 hex-board/手牌区抢竖屏旋转后有限的本地高度预算。
       竖屏时整屏旋转90°，本地坐标的"左右"其实对应物理屏幕的"上下"——用静态 CSS 的 left/right
       硬编容易把方向搞反(之前两个键因此被甩到物理屏幕正上方和正下方两端)。改成两个键各自
       position:fixed，具体 left/top 由 positionActionBar6p()(用 gdToLocal 把"期望的物理屏幕位置"
       换算成本地坐标)在 JS 里写入，横竖屏都不用再手算旋转方向。*/
    #action-bar-6p { display: none; pointer-events: none; }   /* 仅 6 人模式显示，见 body.mode-6p #action-bar-6p */
    #action-bar-6p .action-btn {
      position: fixed; z-index: 55; transform: translate(-50%, -50%);
      pointer-events: auto;
      /* 在原 .action-btn 基础上整体再缩小20% */
      padding: 7px 16px; font-size: .68rem; border-radius: 13px;
    }
    /* 轮到本家出牌：不出/出牌两键一起亮起来，醒目提示及时操作 */
    #action-bar-6p .action-btn.my-turn {
      border-color: #FFE066; border-width: 2px;
      box-shadow: 0 0 16px 4px rgba(255,224,102,.75), 0 0 0 2px rgba(255,224,102,.35);
      animation: pulse-actionbtn 1s ease-in-out infinite;
    }
    @keyframes pulse-actionbtn {
      0%, 100% { box-shadow: 0 0 16px 4px rgba(255,224,102,.75), 0 0 0 2px rgba(255,224,102,.35); }
      50%      { box-shadow: 0 0 26px 8px rgba(255,224,102,.95), 0 0 0 3px rgba(255,224,102,.55); }
    }
    #action-hint-6p { display: none; }   /* 提示已由中央倒计时/徽章体现，避免遮挡 */

    /* ═══════════════ 进贡层 ═══════════════ */
    #tribute-overlay {
      display: none; position: fixed; inset: 0; z-index: 280;
      background: rgba(0,0,0,.88); backdrop-filter: blur(6px);
      flex-direction: column; align-items: center; justify-content: center; gap: 14px;
      padding: 20px;
    }
    .tribute-title {
      font-size: 1.3rem; font-weight: 900; color: #FFE066; letter-spacing: 4px; margin-bottom: 4px;
    }
    .tribute-sub { font-size: .78rem; color: rgba(255,255,255,.45); letter-spacing: 2px; }
    .tribute-card-display {
      background: rgba(255,255,255,.06); border: 1px solid rgba(212,172,13,.3);
      border-radius: 14px; padding: 14px 20px; text-align: center; min-width: 160px;
    }
    .tribute-card-display .tc-label { font-size: .68rem; color: rgba(255,255,255,.4); letter-spacing: 2px; margin-bottom: 8px; }
    .tribute-card-display .tc-card { font-size: 2.2rem; }
    .tribute-return-area { width: 100%; max-width: 380px; }
    .tribute-return-area .tr-label { font-size: .72rem; color: rgba(255,255,255,.5); letter-spacing: 2px; margin-bottom: 8px; text-align: center; }
    #tribute-return-hand { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; max-height: 200px; overflow-y: auto; }
    #tribute-return-hand .card {
      cursor: pointer; border-radius: 6px; border: 2px solid transparent;
      transition: all .2s; transform-origin: bottom center;
    }
    #tribute-return-hand .card.selected { border-color: #FFE066; transform: translateY(-6px); }
    #tribute-return-btn {
      display: block; width: 100%; max-width: 200px; margin: 14px auto 0;
      padding: 12px; border-radius: 12px; border: none; cursor: pointer;
      background: linear-gradient(135deg,#C0000F,#8B0000); color: #fff;
      font-size: .9rem; font-weight: 900; letter-spacing: 3px;
    }
    #tribute-return-btn:disabled { opacity: .4; cursor: not-allowed; }
    .tribute-waiting-text { color: rgba(255,255,255,.5); font-size: .85rem; letter-spacing: 2px; }
    .tribute-giver-info { background: rgba(255,255,255,.06); border-radius: 12px; padding: 14px 20px; text-align: center; }
    .tribute-giver-info .tgi-card { font-size: 1.6rem; margin-bottom: 6px; }
    .tribute-giver-info .tgi-text { font-size: .78rem; color: rgba(255,255,255,.55); }
    .tribute-resisted { font-size: 1rem; color: #FFE066; letter-spacing: 2px; }
    /* 进贡方手牌（点最大牌进贡） */
    #tribute-give-hand { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center;
      max-height: 210px; overflow-y: auto; max-width: 420px; }
    #tribute-give-hand .card, #tribute-return-hand .card {
      cursor: pointer; border-radius: 6px; border: 2px solid transparent; transition: all .2s;
      transform-origin: bottom center; }
    #tribute-give-hand .card.selected { border-color: #FFE066; transform: translateY(-6px); }
    #tribute-give-hand .card.disabled, #tribute-return-hand .card.disabled {
      opacity: .32; cursor: not-allowed; filter: grayscale(.5); }
    #tribute-give-btn {
      display: block; width: 100%; max-width: 200px; margin: 14px auto 0;
      padding: 12px; border-radius: 12px; border: none; cursor: pointer;
      background: linear-gradient(135deg,#C0000F,#8B0000); color: #fff;
      font-size: .9rem; font-weight: 900; letter-spacing: 3px; }
    #tribute-give-btn:disabled { opacity: .4; cursor: not-allowed; }
    #tribute-notice {
      display: none; position: fixed; inset: 0; z-index: 300;
      align-items: center; justify-content: center; pointer-events: none; }
    #tribute-notice-text {
      background: rgba(20,20,35,.96); border: 2px solid #FFE066; border-radius: 16px;
      padding: 20px 30px; color: #FFE066; font-size: 1.15rem; font-weight: 900; letter-spacing: 3px;
      text-align: center; box-shadow: 0 8px 40px rgba(0,0,0,.6); white-space: pre-line; line-height: 1.6; }
    #tribute-fly-layer { position: fixed; inset: 0; z-index: 290; pointer-events: none; }
    .tribute-fly-card {
      position: fixed; width: 46px; height: 64px; border-radius: 6px; background: #fff;
      display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 1.1rem;
      box-shadow: 0 6px 20px rgba(0,0,0,.5); transition: transform .8s cubic-bezier(.4,.1,.3,1), opacity .8s; }
    /* 进贡记录列表 */
    #tribute-log { width: 100%; max-width: 340px; display: flex; flex-direction: column; gap: 6px; }
    .tribute-log-item { background: rgba(255,255,255,.05); border-radius: 8px; padding: 8px 12px; font-size: .75rem; color: rgba(255,255,255,.6); text-align: center; }
    .tribute-log-item.done { color: #80D4A8; }

    /* 并列贡牌：还供牌摆在大屏正中央，供并列的进贡方选牌(谁离头游名次近谁先选，7/20 秒仲裁) */
    #tie-overlay {
      display: none; position: fixed; left: 50%; top: 50%; transform: translate(-50%,-50%);
      z-index: 320; background: rgba(10,6,20,.94); border: 2px solid #FFE066; border-radius: 18px;
      padding: 18px 26px 22px; text-align: center; box-shadow: 0 10px 46px rgba(0,0,0,.6);
      max-width: 92vw;
    }
    #tie-overlay .tie-title { font-size: 1.05rem; font-weight: 900; color: #FFE066; letter-spacing: 3px; margin-bottom: 6px; }
    #tie-overlay .tie-hint  { font-size: .8rem; color: rgba(255,255,255,.75); letter-spacing: 1px; margin-bottom: 12px; min-height: 1.2em; }
    #tie-overlay .tie-cards { display: flex; gap: 16px; justify-content: center; margin-bottom: 10px; flex-wrap: wrap; }
    .tie-card-box {
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      padding: 8px; border-radius: 12px; border: 2px solid rgba(255,255,255,.15);
      background: rgba(255,255,255,.04); transition: all .2s;
    }
    .tie-card-box .tc-face { font-size: 1.7rem; }
    .tie-card-box .tc-who  { font-size: .62rem; color: rgba(255,255,255,.4); letter-spacing: 1px; }
    .tie-card-box.pickable { cursor: pointer; border-color: #FFE066; box-shadow: 0 0 14px rgba(255,224,102,.35); }
    .tie-card-box.pickable:hover { transform: translateY(-4px); }
    #tie-overlay .tie-countdown { font-size: .78rem; color: #FF9E6B; font-weight: 900; letter-spacing: 2px; }

    /* ═══════════════ 等候层 ═══════════════ */
    #wait-overlay {
      display: none; position: fixed; inset: 0; z-index: 150;
      background: radial-gradient(ellipse at 50% 40%, #1d5c1d 0%, #0d2d0d 55%, #061306 100%);
      flex-direction: column; align-items: center; justify-content: center; gap: 0;
      padding: 12px; overflow: auto;   /* 内容极端偏多时可滚动，不再裁掉座位 */
    }
    .wait-logo { width: 40px; height: 40px; border-radius: 50%; margin-bottom: 7px; }
    .wait-title {
      font-size: .95rem; font-weight: 900; color: #FFE066; letter-spacing: 3px; margin-bottom: 3px;
    }
    .wait-sub {
      font-size: .68rem; color: rgba(255,255,255,.4); letter-spacing: 2px; margin-bottom: 12px;
    }
    /* 进度条 */
    .wait-progress {
      font-size: 1.35rem; font-weight: 900; color: #fff; letter-spacing: 2px; margin-bottom: 3px;
    }
    .wait-progress span { color: #FFE066; }
    .wait-progress-label {
      font-size: .68rem; color: rgba(255,255,255,.4); letter-spacing: 3px; margin-bottom: 10px;
    }
    /* 座位格：六人排成 3列×2行，整体更矮 → 旋转后不再溢出、六个座位都可见 */
    .wait-seats {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
      width: 100%; max-width: 520px; margin-bottom: 10px;
    }
    .wait-seat {
      border-radius: 12px; padding: 9px 11px;
      background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
      display: flex; align-items: center; gap: 8px;
      transition: all .3s;
    }
    .wait-seat.filled { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.2); }
    .wait-seat.me     { border-color: rgba(212,172,13,.5); background: rgba(212,172,13,.08); }
    .wait-seat-num {
      width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center;
      justify-content: center; font-size: .72rem; font-weight: 700; flex-shrink: 0;
      background: rgba(255,255,255,.08); color: rgba(255,255,255,.4);
    }
    .wait-seat.filled .wait-seat-num { background: rgba(255,255,255,.18); color: #fff; }
    .wait-seat.me .wait-seat-num { background: rgba(212,172,13,.3); color: #FFE066; }
    .wait-seat-info { flex: 1; min-width: 0; }
    .wait-seat-name { font-size: .82rem; color: rgba(255,255,255,.35); }
    .wait-seat.filled .wait-seat-name { color: #fff; font-weight: 700; }
    .wait-seat.me .wait-seat-name { color: #FFE066; }
    .wait-seat-team { font-size: .62rem; color: rgba(255,255,255,.25); letter-spacing: 1px; margin-top: 2px; }
    .wait-seat.filled .wait-seat-team { color: rgba(255,255,255,.45); }
    /* 房间号分享区（私人房间显示） */
    #wait-room-code-box {
      display: none; text-align: center; background: rgba(0,0,0,.3);
      border: 1px solid rgba(212,172,13,.25); border-radius: 12px;
      padding: 10px 18px; width: 100%; max-width: 320px; margin-bottom: 10px;
    }
    #wait-room-code-box .wrc-label { font-size: .62rem; color: rgba(212,172,13,.7); letter-spacing: 4px; margin-bottom: 4px; }
    #wait-room-code-box .wrc-value { font-size: 1.6rem; font-weight: 900; color: #FFE066; letter-spacing: 9px; }
    #wait-room-code-box .wrc-copy  {
      margin-top: 6px; font-size: .68rem; color: rgba(212,172,13,.7); cursor: pointer;
      padding: 3px 12px; border: 1px solid rgba(212,172,13,.3); border-radius: 12px;
      display: inline-block; letter-spacing: 1px;
    }
    #wait-room-code-box .wrc-copy:hover { color: #FFE066; border-color: rgba(212,172,13,.5); }
    /* 等候动画点 */
    .wait-dots { font-size: .82rem; color: rgba(255,255,255,.3); letter-spacing: 4px; }
    .wait-dots span { animation: dotBlink 1.4s ease infinite; }
    .wait-dots span:nth-child(2) { animation-delay: .2s; }
    .wait-dots span:nth-child(3) { animation-delay: .4s; }
    @keyframes dotBlink { 0%,80%,100%{opacity:.2} 40%{opacity:1} }
  </style>
</head>
<body>

<!-- 微信/QQ/微博等内置浏览器：顶部/底部会被对方App自己的工具条遮住一块屏幕(这层UI我们
