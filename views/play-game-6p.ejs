/* ══════════ 锁定牌型（预先理牌 · 个人本地辅助 · 不影响规则/不发服务端）══════════
   仅锁 5 张及以上组合 + 4 张以上炸弹；单张/对子/三张不锁。
   每组一个独立颜色；点组内任意一张=选中整组，再"出牌"整体打出——锁定的必须是能一次性
   整体合法出完的牌型，不允许只拆一部分选。已整组选中时再点一下=直接解锁回散牌，
   保证锁牌绝不会让玩家因"只能整组出"而卡住找不到需要的那一张。*/
var lockedCombos  = [];   // [{ cards:[code...], keys:[code_idx...], color, label }]
var COMBO_COLORS  = ['#FFD54A','#5AD17A','#5AA9FF','#C89BFF','#FF9E6B','#4DD0C0','#F06BB0','#B0C94D'];
var LOCKABLE_TYPES = ['fullhouse','straight','flush_straight','bomb','flush_bomb','dbl_straight','triple_straight','joker_bomb'];

function comboNextColor(){
  var used = lockedCombos.map(function(c){ return c.color; });
  for (var i=0;i<COMBO_COLORS.length;i++){ if(used.indexOf(COMBO_COLORS[i])<0) return COMBO_COLORS[i]; }
  return COMBO_COLORS[lockedCombos.length % COMBO_COLORS.length];
}
function comboOfKey(key){
  for (var i=0;i<lockedCombos.length;i++){ if(lockedCombos[i].keys.indexOf(key)>=0) return lockedCombos[i]; }
  return null;
}
/* 手牌重排/出牌后：把每组实体牌重新对应到新手牌 idx；组牌已不在则丢弃该组 */
function remapCombos(newHand){
  var used = {}, keep = [];
  lockedCombos.forEach(function(combo){
    var newKeys = [], ok = true;
    combo.cards.forEach(function(code){
      var found = -1;
      for (var i=0;i<newHand.length;i++){ if(newHand[i]===code && !used[i]){ found=i; break; } }
      if(found<0){ ok=false; return; }
      used[found]=true; newKeys.push(code+'_'+found);
    });
    if(ok){ combo.keys = newKeys; keep.push(combo); }
  });
  lockedCombos = keep;
}
/* 「锁牌」按牌型分两端摆放：炸弹类(普通炸弹4/5/6张、同花顺、王炸/天炸——_isBomb() 判定，
   跟出牌比大小时的"炸弹"定义完全一致)锁到手牌最左端；非炸弹类(顺子/三带二/钢板/姊妹对等)
   锁到手牌最右端。中间是未锁定的散牌，照常级牌排序。撤销/重置后散牌自动归位到原始排列。 */
function reorderHandLockedFirst(){
  var inCombo = {}, frontGroups = [], backGroups = [];
  lockedCombos.forEach(function(combo){
    var cards = [];
    combo.keys.forEach(function(key){
      var idx = parseInt(key.slice(key.lastIndexOf('_') + 1), 10);
      if (!inCombo[idx]) { inCombo[idx] = true; cards.push(myHand[idx]); }
    });
    var sorted = sortComboCards(cards, combo, levelCard);
    var isBomb = _isBomb({ type: combo.type });
    /* 每组按牌型大小算一个可比分：炸弹类用 _bombScore（跟出牌比大小同一套标准），
       非炸弹类(顺子/三带二/钢板/姊妹对)直接用 value(点数序)——多组同侧锁定时按大小顺序竖排 */
    var score = isBomb ? _bombScore({ type: combo.type, size: cards.length, value: combo.value }) : (combo.value || 0);
    (isBomb ? frontGroups : backGroups).push({ cards: sorted, score: score });
  });
  frontGroups.sort(function(a,b){ return b.score - a.score; });
  backGroups.sort(function(a,b){ return b.score - a.score; });
  var front = [].concat.apply([], frontGroups.map(function(g){ return g.cards; }));
  var back  = [].concat.apply([], backGroups.map(function(g){ return g.cards; }));
  var rest = [];
  myHand.forEach(function(code, idx){ if (!inCombo[idx]) rest.push(code); });
  myHand = front.concat(sortHandLevel(rest, levelCard)).concat(back);
  remapCombos(myHand);
}
function comboReRender(){
  if (GAME_MODE === '6p') { render6pHand(myHand); syncButtons6p(); updateSelInfo6p(); }
  else                    { renderHand(myHand);   syncButtons();   updateSelInfo();   }
  updatePlayButtonState();
}
/* 锁定后手牌区可能横向溢出：新锁的组炸弹靠最左/非炸弹靠最右，若不在可视区看起来就像"没锁住"，
   这里自动把手牌横向滚动条拉到对应一侧，确保刚锁的组立刻可见。 */
function scrollLockedIntoView(isBomb){
  var el = document.getElementById(GAME_MODE === '6p' ? 'hand-scroll-6p' : 'hand-scroll');
  if (!el) return;
  el.scrollLeft = isBomb ? 0 : el.scrollWidth;
}
function lockCombo(){
  if(selected.length < 4){ showToast('单张/对子/三张不用锁，请选 5 张以上组合或炸弹'); return; }
  for (var i=0;i<selected.length;i++){ if(comboOfKey(selected[i])){ showToast('选中的牌里有已锁定的，请先撤销那一组'); return; } }
  var cards = selected.map(function(k){ return k.split('_')[0]; });
  var pt = gdDetect(cards, levelCard);
  if(!pt || LOCKABLE_TYPES.indexOf(pt.type) < 0){ showToast('⚠️ 非法组合，无法锁定'); return; }
  lockedCombos.push({ cards: cards.slice(), keys: selected.slice(), color: comboNextColor(), label: pt.label || '组合', type: pt.type, value: pt.value });
  selected = [];
  reorderHandLockedFirst();   // 炸弹类锁最左，非炸弹类锁最右，同侧按大小顺序竖排
  comboReRender();
  scrollLockedIntoView(_isBomb({ type: pt.type }));
  showToast('✅ 已锁定：' + (pt.label || '组合'));
}
function unlockCombo(){
  var target = null;
  for (var i=0;i<selected.length;i++){ var c = comboOfKey(selected[i]); if(c){ target = c; break; } }
  if(!target){ showToast('请先点要撤销的组合里的任意一张牌，再点撤销设置'); return; }
  lockedCombos = lockedCombos.filter(function(c){ return c !== target; });
  selected = [];
  reorderHandLockedFirst();   // 撤销后：该组牌归位，剩余锁定组仍在左
  comboReRender();
  showToast('↩️ 已撤销该组合');
}
/* 全部重置（万能急救键）：任何情况下都把牌恢复到原始排列组合，并清空一切选中/锁定状态，
   确保之后可以点选任意大牌正常出牌——绝不出现"卡住出不去牌"。 */
function resetCombos(){
  lockedCombos   = [];
  selected       = [];                           // 清空一切选中
  _straightCycle = null;                         // 清顺子/同花顺凑牌循环状态
  if (typeof swipeEnd === 'function') swipeEnd();  // 万一滑选状态卡死(触摸序列被打断)，重置也要顺带救回来
  myHand = sortHandLevel(myHand, levelCard);     // 恢复原始级牌排序（不再有锁定组置左）
  comboReRender();                               // 重绘 + 刷新出牌按钮状态
  /* 万能急救：向服务端重新拉取权威状态，修正任何残留的"必须压过"死锁
     —— 弱网/丢包导致 hasLastPlay/lastPlayType 过期时，先出方会被误判"压不过"而永远红色出不了牌，
     这里强制重同步 game:hand + game:state 后即可正常出牌。 */
  try { socket.emit('game:request_hand', { token: MY_TOKEN, roomCode: ROOM_CODE }); } catch(_){}
  showToast('🔄 已重置，牌型已复原');
}
/* ══════ 同花顺智能凑牌 ══════
   用法：先点「牌型里的一张牌」当锚点(可不选)，再点「同花顺」按钮。
   系统自动从手牌里凑出一副同花顺(5张同花色连牌)；缺哪张就用红桃级牌(逢人配)顶上；
   实在凑不齐则提示「同花顺缺牌」。凑齐后自动选中这5张，玩家再点绿色「出牌」或「锁牌」。*/
function findFlushStraight(){
  var wild = levelCard ? ('H' + _rankChar(levelCard)) : null;   // 逢人配=红桃级牌
  /* 1) 可用牌(未锁定的散牌)：按 code 收集手牌下标；逢人配单独收集 */
  var availByCode = {}, wildIdx = [];
  myHand.forEach(function(code, idx){
    if (comboOfKey(code + '_' + idx)) return;           // 已锁定的组不参与
    if (wild && code === wild) { wildIdx.push(idx); return; }
    (availByCode[code] = availByCode[code] || []).push(idx);
  });
  /* 2) 锚点：当前选中里第一张「普通花色牌」的花色+点数(逢人配/王不当锚) */
  var anchor = null;
  for (var s = 0; s < selected.length; s++){
    var ac = selected[s].split('_')[0];
    if (ac === 'BJ' || ac === 'LJ' || (wild && ac === wild)) continue;
    anchor = { suit: ac[0], rank: RANK_ORD[ac.slice(1)], idx: parseInt(selected[s].split('_')[1], 10) };
    break;
  }
  var suits   = anchor ? [anchor.suit] : ['S','H','D','C'];
  /* 3) 所有 5 连窗口：top 14..6 自然连 + A2345(A当1)轮顺 */
  var windows = [];
  for (var top = 14; top >= 6; top--) windows.push([top, top-1, top-2, top-3, top-4]);
  windows.push([14,5,4,3,2]);
  var best = null;   // {idxs, wilds, top, suit}
  suits.forEach(function(S){
    windows.forEach(function(win){
      if (anchor && (S !== anchor.suit || win.indexOf(anchor.rank) < 0)) return;
      var usedIdx = {}, pick = [], wUsed = 0, ok = true;
      win.forEach(function(r){
        if (!ok) return;
        if (anchor && S === anchor.suit && r === anchor.rank && !usedIdx[anchor.idx]){
          usedIdx[anchor.idx] = true; pick.push(anchor.idx); return;   // 锚点这一格用锚点实体牌
        }
        var list = availByCode[S + _rankChar(r)] || [], got = -1;
        for (var i = 0; i < list.length; i++){ if(!usedIdx[list[i]]){ got = list[i]; break; } }
        if (got >= 0){ usedIdx[got] = true; pick.push(got); return; }
        /* 缺这张 → 用逢人配顶 */
        var wi = -1;
        for (var j = 0; j < wildIdx.length; j++){ if(!usedIdx[wildIdx[j]]){ wi = wildIdx[j]; break; } }
        if (wi >= 0){ usedIdx[wi] = true; pick.push(wi); wUsed++; return; }
        ok = false;
      });
      if (ok && pick.length === 5){
        var t = (win[0] === 14 && win[4] === 2) ? 5 : win[0];   // 轮顺 A2345 记作顶5
        if (!best || wUsed < best.wilds || (wUsed === best.wilds && t < best.top))
          best = { idxs: pick.slice(), wilds: wUsed, top: t, suit: S };
      }
    });
  });
  if (!best){ showToast('⚠️ 同花顺缺牌'); return; }
  selected = best.idxs.map(function(idx){ return myHand[idx] + '_' + idx; });
  comboReRender();
  var sym = ({S:'♠',H:'♥',D:'♦',C:'♣'})[best.suit] || '';
  showToast('✅ 已凑齐同花顺 ' + sym + (best.wilds ? '（用了'+best.wilds+'张逢人配）' : ''));
}

/* ══════ 顺子智能凑牌（不限花色 · 可循环换头尾）══════
   用法：点「一张牌」当锚点(可不选)，再点「顺子」→ 自动凑一副 5 张连牌；缺牌用红桃级牌(逢人配)顶；
   再点一次「顺子」在包含锚点的多副顺子间循环(换头尾)。凑齐后自动选中，玩家再点绿色「出牌」或「锁牌」。*/
var _straightCycle = null;   // { lastSel, anchor, pos }
function findStraight(){
  var wild = levelCard ? ('H' + _rankChar(levelCard)) : null;   // 逢人配=红桃级牌
  /* 1) 可用牌(未锁定的散牌)按点数收集(不限花色)；逢人配单独收集；王不入顺子 */
  var availByRank = {}, wildIdx = [];
  myHand.forEach(function(code, idx){
    if (comboOfKey(code + '_' + idx)) return;
    if (wild && code === wild) { wildIdx.push(idx); return; }
    if (code === 'BJ' || code === 'LJ') return;
    var r = RANK_ORD[code.slice(1)]; if (!r) return;
    (availByRank[r] = availByRank[r] || []).push(idx);
  });
  /* 2) 锚点：延续上次(选中未变=循环换一副)则沿用；否则取当前选中里第一张普通牌 */
  var selSig  = selected.slice().sort().join(',');
  var cycling = !!(_straightCycle && _straightCycle.lastSel === selSig);
  var anchor  = null;
  if (cycling) { anchor = _straightCycle.anchor; }
  else {
    for (var s = 0; s < selected.length; s++){
      var ac = selected[s].split('_')[0];
      if (ac === 'BJ' || ac === 'LJ' || (wild && ac === wild)) continue;
      var ar = RANK_ORD[ac.slice(1)]; if (!ar) continue;
      anchor = { rank: ar, idx: parseInt(selected[s].split('_')[1], 10) };
      break;
    }
  }
  /* 3) 所有 5 连窗口：top 14..6 自然连 + A2345(A当1)轮顺 */
  var windows = [];
  for (var top = 14; top >= 6; top--) windows.push([top, top-1, top-2, top-3, top-4]);
  windows.push([14, 5, 4, 3, 2]);
  var cands = [];
  windows.forEach(function(win){
    if (anchor && win.indexOf(anchor.rank) < 0) return;
    var usedIdx = {}, pick = [], wUsed = 0, ok = true;
    win.forEach(function(r){
      if (!ok) return;
      if (anchor && r === anchor.rank && !usedIdx[anchor.idx]) { usedIdx[anchor.idx] = true; pick.push(anchor.idx); return; }
      var list = availByRank[r] || [], got = -1;
      for (var i = 0; i < list.length; i++){ if (!usedIdx[list[i]]) { got = list[i]; break; } }
      if (got >= 0){ usedIdx[got] = true; pick.push(got); return; }
      /* 缺这张 → 用逢人配顶 */
      var wi = -1;
      for (var j = 0; j < wildIdx.length; j++){ if (!usedIdx[wildIdx[j]]) { wi = wildIdx[j]; break; } }
      if (wi >= 0){ usedIdx[wi] = true; pick.push(wi); wUsed++; return; }
      ok = false;
    });
    if (ok && pick.length === 5){
      var t = (win[0] === 14 && win[4] === 2) ? 5 : win[0];   // 轮顺 A2345 记作顶5
      cands.push({ idxs: pick.slice(), wilds: wUsed, top: t });
    }
  });
  if (!cands.length){ showToast('⚠️ 顺子缺牌'); _straightCycle = null; return; }
  cands.sort(function(a, b){ return a.wilds - b.wilds || b.top - a.top; });   // 少用逢人配、点数高者优先
  var pos    = cycling ? ((_straightCycle.pos + 1) % cands.length) : 0;
  var chosen = cands[pos];
  selected = chosen.idxs.map(function(idx){ return myHand[idx] + '_' + idx; });
  _straightCycle = { lastSel: selected.slice().sort().join(','), anchor: anchor, pos: pos };
  comboReRender();
  showToast('✅ 已凑齐顺子' + (chosen.wilds ? '（用了' + chosen.wilds + '张逢人配）' : '') + (cands.length > 1 ? '　再点「顺子」换一副' : ''));
}

/* 点圆球：执行动作，并短暂浮现该球的文字标签（触屏无悬停）*/
function comboTapBall(el, fn){
  if (el) { el.classList.add('show-tip'); clearTimeout(el._tipT);
    el._tipT = setTimeout(function(){ el.classList.remove('show-tip'); }, 1500); }
  if (typeof fn === 'function') fn();
}

/* ── 滑动选牌：手指/鼠标划过多张牌=依次选中（松手不自动出，仍需点绿色"出牌"）──
   ⚠️ 原则性修复：swipeMove 原来从 pointerdown/touchstart 那一刻起就"零阈值"生效——
   哪怕只是单击一张卡产生的 1~2px 自然抖动，也会被当成"划过"直接把卡加进 selected；
   随后 touchend/pointerup 触发 attachTap 的 toggle 又把同一张卡切换掉，一来一回等于
   白点——这正是"华为/安卓点击牌要点好几次才成功"的另一半根因(前一半是两边阈值不一致
   的死区，见 TAP_MOVE_PX 处注释)。现在滑选必须先越过和单击同样大小的 TAP_MOVE_PX 阈值
   才"真正启动"，越阈值之前的抖动完全不介入选牌，交给 attachTap 的单击 toggle 独立处理，
   两者不再互相打架。 */
var _swipe = { active:false, seen:null, armed:false, sx:0, sy:0 };
function swipeMove(e){
  if (!_swipe.active) return;
  var pt = (e.touches && e.touches[0]) ? e.touches[0] : e;   // 兼容 touch/pointer 两种事件对象
  if (!_swipe.armed) {
    if (Math.abs(pt.clientX - _swipe.sx) <= TAP_MOVE_PX && Math.abs(pt.clientY - _swipe.sy) <= TAP_MOVE_PX) return;
    _swipe.armed = true;   // 越过阈值，确认是真滑动而非单击抖动，才开始接管选牌
  }
  var el = document.elementFromPoint(pt.clientX, pt.clientY);
  var card = el && el.closest ? el.closest('.hand-card') : null;
  if (!card || card.dataset.code == null) return;
  var key = card.dataset.code + '_' + card.dataset.idx;
  if (_swipe.seen[key]) return;
  _swipe.seen[key] = true;
  if (selected.indexOf(key) < 0) {
    selected.push(key);
    card.classList.add('selected');   // 直接加类，不整重绘，避免打断指针拖动
    updateSelInfo6p(); syncButtons6p(); updatePlayButtonState();
  }
}
function swipeEnd(){
  _swipe.active = false; _swipe.seen = null; _swipe.armed = false;
  document.removeEventListener('pointermove', swipeMove);
  document.removeEventListener('pointerup', swipeEnd);
  document.removeEventListener('pointercancel', swipeEnd);
  document.removeEventListener('touchmove', swipeMove);
  document.removeEventListener('touchend', swipeEnd);
  document.removeEventListener('touchcancel', swipeEnd);
}
function swipeStart(e){
  if (typeof tbEx !== 'undefined' && tbEx.length) return;   // 进贡态不滑选（供/还是单张点选）
  var pt = (e.touches && e.touches[0]) ? e.touches[0] : e;
  _swipe.active = true; _swipe.seen = {}; _swipe.armed = false;
  _swipe.sx = pt.clientX; _swipe.sy = pt.clientY;
  document.addEventListener('pointermove', swipeMove);
  document.addEventListener('pointerup', swipeEnd);
  document.addEventListener('pointercancel', swipeEnd);
  /* 同 attachTap：部分安卓机型/微信内置浏览器 Pointer Events 不可靠，独立挂一条 touch 通路兜底 */
  document.addEventListener('touchmove', swipeMove, { passive: true });
  document.addEventListener('touchend', swipeEnd);
  document.addEventListener('touchcancel', swipeEnd);
}
/* 兜底：万一一次触摸序列中途被打断(切后台/来电/系统手势抢占)，touchend/pointerup/cancel
   都没能触发，_swipe.active 会永久卡 true——此后哪怕只是正常点单张牌，只要指头有一点点
   移动就会被当成"还在滑选"而误加牌。绝不能靠"重置"才能救回来，页面一旦不可见就直接强制收尾。 */
document.addEventListener('visibilitychange', function(){ if (document.hidden) swipeEnd(); });
window.addEventListener('blur', swipeEnd);
(function(){
  var h = document.getElementById('hand-scroll-6p');
  if (h) {
    h.addEventListener('pointerdown', swipeStart);
    h.addEventListener('touchstart', swipeStart, { passive: true });
  }
})();

function build6pCardEl(code, idx){
  var key  = code + '_' + idx;
  var isSel = selected.indexOf(key) >= 0;
  var card = document.createElement('div');
  card.className = 'hand-card' + (isSel ? ' selected' : '');
  card.dataset.code = code; card.dataset.idx = idx;   // 供滑动选牌命中
  card.classList.add('hand-card-6p');
  card.innerHTML = GDCard.faceSVG(code);              // 高清矢量牌面
  var _cmb = comboOfKey(key);
  if (_cmb) { card.classList.add('locked'); card.style.setProperty('--combo', _cmb.color); }
  /* 进贡态：仅供牌方高亮最大牌，其余变暗；还供方不再锁牌高亮(挡视线)，手牌正常显示、直接点选 */
  if (typeof tbEx !== 'undefined' && tbEx.length) {
    var _g = tbMyGiveEx();
    if (_g) card.classList.add(tbGiveCandsOf(_g).indexOf(code) >= 0 ? 'tb-cand' : 'tb-dim');
  }
  attachTap(card, (function(c, i){ return function(){ toggleCard6p(c, i); }; })(code, idx));
  return card;
}

/* 六人手牌：同点数竖排成列 */
function render6pHand(hand) {
  var scroll = document.getElementById('hand-scroll-6p');
  scroll.innerHTML = '';
  var curKey = null, colEl = null;
  hand.forEach(function(code, idx) {
    /* #3 锁定组(顺子/同花顺/炸弹等)整组竖向相叠成"一列"，固定在最左；散牌仍按点数分列 */
    var cmb = comboOfKey(code + '_' + idx);
    var k   = cmb ? ('cmb_' + lockedCombos.indexOf(cmb)) : rankKeyOf(code);
    if (k !== curKey) {
      colEl = document.createElement('div');
      colEl.className = 'hand-col' + (cmb ? ' combo-col' : '');
      if (cmb) colEl.style.setProperty('--combo', cmb.color);
      scroll.appendChild(colEl);
      curKey = k;
    }
    var card = build6pCardEl(code, idx);
    if (colEl.children.length > 0) card.classList.add('stacked');
    colEl.appendChild(card);
  });
}

function toggleCard6p(code, idx) {
  if (typeof tbTapCard === 'function' && tbEx.length && tbTapCard(code)) return;  // 进贡态：点牌=供/还
  var key = code + '_' + idx;
  var cmb = comboOfKey(key);
  var affectedKeys;
  if (cmb) {
    /* 锁定组的原则：被锁定的牌型必须是能按掼蛋规则一次性整体出完的合法牌型（锁定时已校验），
       所以点选时只能整组选/整组出，不允许只拆一部分——那样就不再是"锁定的那个合法牌型"了。
       已整组选中时再点一下 = 直接解锁回散牌（不用去点单独的"撤销设置"按钮），
       这样锁牌绝不会让玩家因为"只能整组出"而找不到需要的那一张卡住出不了牌。 */
    var allSel = cmb.keys.every(function(k){ return selected.indexOf(k) >= 0; });
    if (allSel) {
      lockedCombos = lockedCombos.filter(function(c){ return c !== cmb; });
      selected = [];
      reorderHandLockedFirst();
      comboReRender();
      showToast('↩️ 已解锁该组合');
      return;
    }
    selected = cmb.keys.slice();
    affectedKeys = cmb.keys;
  } else {
    /* 散牌：若原来选中的是某锁定组，先清空避免混合——这种情况很少见，
       牌型互斥直接整手重绘最简单可靠，不必为这个冷门分支做增量优化 */
    if (selected.some(function(k){ return comboOfKey(k); })){
      selected = [];
      render6pHand(myHand);
      syncButtons6p(); updateSelInfo6p(); updatePlayButtonState();
      return;
    }
    var i = selected.indexOf(key);
    if (i >= 0) selected.splice(i, 1);
    else         selected.push(key);
    affectedKeys = [key];
  }
  /* ⚠️ 性能修复："苹果丝滑、华为/安卓不跟手"的主要原因：以前这里点一下就 render6pHand()
     整手重绘——六人手牌常有20+张，每张都带SVG矢量牌面+好几套触摸/指针事件监听，每次点击
     都全部销毁重建，在低端安卓/华为上有明显可感知的卡顿延迟，iPhone硬件更强所以不明显。
     改成只切换被点中这几张牌(单张或整组)的 selected 样式类，不碰其余 DOM，跟 swipeMove()
     滑选时"直接加类不重绘"是同一个思路。 */
  affectedKeys.forEach(function(k){
    var sep = k.lastIndexOf('_');
    var c = k.slice(0, sep), ix = k.slice(sep + 1);
    var el = document.querySelector('.hand-card-6p[data-code="' + c + '"][data-idx="' + ix + '"]');
    if (el) el.classList.toggle('selected', selected.indexOf(k) >= 0);
  });
  syncButtons6p();
  updateSelInfo6p();
  updatePlayButtonState();
}

function updateSelInfo6p() {
  var n = selected.length;
  document.getElementById('sel-info-6p').textContent    = n > 0 ? '· 已选' + n + '张' : '';
  document.getElementById('sel-info-6p').style.display  = n > 0 ? 'inline' : 'none';
  document.getElementById('btn-cancel-6p').style.display = n > 0 ? 'inline-block' : 'none';
  document.getElementById('btn-play-6p').textContent    = n > 0 ? '出牌(' + n + ')' : '出牌';
}

function syncButtons6p() {
  var passBtn = document.getElementById('btn-pass-6p');
  var playBtn = document.getElementById('btn-play-6p');
  passBtn.disabled = !isMyTurn || !hasLastPlay;
  passBtn.classList.toggle('my-turn', isMyTurn);
  playBtn.classList.toggle('my-turn', isMyTurn);
  updatePlayButtonState();
}
</script>
</body>
</html>
