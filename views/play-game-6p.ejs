function chatEditVerify(){
  var u = document.getElementById('cem-user').value.trim();
  var p = document.getElementById('cem-pass').value;
  var errEl = document.getElementById('cem-err');
  if(!u || !p){ errEl.textContent = '请输入账号和密码'; return; }
  errEl.textContent = '验证中...';
  fetch('/api/gd/chat-phrases/verify', { method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ username:u, password:p }) })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(!d.ok){ errEl.textContent = d.error || '验证失败'; return; }
      _chatEditCred = { username:u, password:p };
      errEl.textContent = '';
      var box = document.getElementById('cem-list'); box.innerHTML = '';
      (d.phrases || CHAT_QUICKS).forEach(function(t){ chatEditAddRow(t); });
      document.getElementById('cem-login').style.display = 'none';
      document.getElementById('cem-editor').style.display = '';
    })
    .catch(function(){ errEl.textContent = '网络错误，请重试'; });
}
