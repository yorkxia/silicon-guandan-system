});

/* ── 房间关闭警告：不满员超时 / 满12h过半掉线（服务端下发 message + seconds）── */
var _closingTimer = null;
socket.on('room:closing', function(d) {
  var secs = (d && d.seconds) || 40;
  var msg  = (d && d.message) || '人数不足，房间即将关闭';
  clearInterval(_closingTimer);
  var tick = function() {
    showToast(msg + '（' + secs + '秒）', 'rgba(192,0,15,.95)');
    if (secs <= 0) { clearInterval(_closingTimer); return; }
    secs--;
  };
  tick();
  _closingTimer = setInterval(tick, 1000);
});
socket.on('room:closing_cancel', function() {
  clearInterval(_closingTimer);
  showToast('玩家已回到房间，取消关闭', 'rgba(30,140,60,.95)');
});
socket.on('room:closed', function() {
  clearInterval(_closingTimer);
  try { gdLS.set('gd-active-room-4p',''); gdLS.set('gd-active-room-6p',''); } catch(e){}   // 房间已关→清返回入口
  alert('房间已关闭，返回参赛大厅。');
  location.href = '/play';
});

/* 供牌：正面牌从贡者飞向收贡方(约3.5秒，全桌看清)，落地后才进入"还供" */
socket.on('tribute:card_flew', function(d) {
  var gSeat = tbSeatOfPlayer(d.giverId), rSeat = tbSeatOfPlayer(d.receiverId);
  flyTributeCard(gSeat, rSeat, d.tributeCard, '供 ' + cardEmoji(d.tributeCard));
  var e = tbEx.find(function(x){ return x.giverId===d.giverId && x.receiverId===d.receiverId; });
  if (e){ e.stage = 'return'; e.tributeCard = d.tributeCard; }
  if (d.giverId === myPlayerId || d.receiverId === myPlayerId) tbBusy = false;
  setTimeout(renderTributeUI, TRIBUTE_FLY_MS);
});

/* 还供：正面牌从收贡方飞回贡者(约3.5秒) */
socket.on('tribute:exchange_done', function(d) {
  var gSeat = tbSeatOfPlayer(d.giverId), rSeat = tbSeatOfPlayer(d.receiverId);
  flyTributeCard(rSeat, gSeat, d.returnCard, '还 ' + cardEmoji(d.returnCard));
  var e = tbEx.find(function(x){ return x.giverId===d.giverId && x.receiverId===d.receiverId; });
  if (e){ e.stage = 'done'; }
  if (d.giverId === myPlayerId || d.receiverId === myPlayerId) tbBusy = false;
  showToast('✅ 进贡 ' + cardEmoji(d.tributeCard) + ' ↔ 还供 ' + cardEmoji(d.returnCard), 'rgba(30,120,60,.92)');
  setTimeout(renderTributeUI, TRIBUTE_FLY_MS);
});

