/* ── 出/不出 位置气泡（跟随出牌方）── */
function seatPanelEl(seat){
  if (GAME_MODE === '6p') return document.getElementById('h-seat-' + seat);
  if (seat === mySeat)    return document.getElementById('my-info-row');
  var rel = buildRelMap(mySeat, 4)[seat];
  var id = rel === 'top' ? 'box-top' : rel === 'left' ? 'box-left' : rel === 'right' ? 'box-right' : null;
  return id ? document.getElementById(id) : null;
}
function showSeatBubble(seat, text, bg){
  var el = seatPanelEl(seat);
  if (!el) return;
  var r = el.getBoundingClientRect();
  if (r.width === 0 && r.height === 0) return;
  var b = document.createElement('div');
  b.textContent = text;
  b.style.cssText = 'position:fixed;z-index:80;padding:3px 16px;border-radius:16px;' +
    'font-size:17px;font-weight:900;letter-spacing:2px;color:#fff;background:' + bg + ';' +
    'box-shadow:0 3px 12px rgba(0,0,0,.45);pointer-events:none;white-space:nowrap;' +
    'left:' + (r.left + r.width/2) + 'px;top:' + (r.top + r.height/2) + 'px;' +
    'transform:translate(-50%,-50%) scale(.5);opacity:0;transition:transform .18s,opacity .18s;';
  document.body.appendChild(b);
  requestAnimationFrame(function(){ b.style.opacity = '1'; b.style.transform = 'translate(-50%,-50%) scale(1)'; });
  setTimeout(function(){
    b.style.opacity = '0';
    setTimeout(function(){ if (b.parentNode) b.parentNode.removeChild(b); }, 220);
  }, 1200);
}
socket.on('player:played', function(d){ showSeatBubble(d.seat, '出',   'rgba(30,150,60,.92)'); });
socket.on('player:passed', function(d){ showSeatBubble(d.seat, '不出', 'rgba(214,150,20,.95)'); });

/* ── 各家出的牌贴近其座位（桌上常有≥3家牌）── */
function clearSeatPlays(){
  for (var s = 1; s <= 6; s++){ var el = document.getElementById('seat-play-'+s); if(el) el.style.display='none'; }
}
/* 竖屏时整个 body 被旋转90°，getBoundingClientRect 返回"屏幕视觉坐标"，
   fixed 子元素 left/top 是"body 本地坐标"，需换算：本地=(视觉y, 屏宽-视觉x) */
/* 跟 CSS 旋转判定读同一个信号(html.gd-portrait，由 fit() 和尺寸一起原子写入)，
   不再单独调 matchMedia 现查一次——避免这里查到的"是否竖屏"跟 CSS 实际用的状态不同步 */
function gdPortrait(){ return document.documentElement.classList.contains('gd-portrait'); }
function gdToLocal(vx, vy){
  if (!gdPortrait()) return { x: vx, y: vy };
  return { x: vy, y: window.innerWidth - vx };
}
/* 六人"不出/出牌"：不再用手牌区/顶栏的边界去猜左右位置——那套换算只在竖屏旋转90度时成立
   (旋转后手牌区在物理左边、顶栏在物理右边)，一到真横屏(不旋转，手牌在物理最下、顶栏在物理最上，
   左右方向根本用不上手牌/顶栏的边界)就会失效，两个键因此被挤在正中间。
   改成直接找左侧座位对(displayIdx 5/6)和右侧座位对(displayIdx 2/3)的真实 getBoundingClientRect()：
   不出贴左侧两个座位框正下方、出牌贴右侧两个座位框正下方，且都比座位框往中心线收一点，
   横屏/竖屏(经 gdToLocal 换算)都保证不跟座位框上下重叠 */
function positionActionBar6p(){
  var passBtn = document.getElementById('btn-pass-6p');
  var playBtn = document.getElementById('btn-play-6p');
  if (!passBtn || !playBtn) return;
  var btnW = passBtn.getBoundingClientRect().width  || 40;
  var btnH = passBtn.getBoundingClientRect().height || 73;
  function pairBox(idxList){
    var rects = [];
    idxList.forEach(function(idx){
      var el = document.querySelector('[data-display-idx="' + idx + '"]');
      if (!el) return;
      var r = el.getBoundingClientRect();
      if (r.width && r.height) rects.push(r);
    });
    if (!rects.length) return null;
    return {
      left:   Math.min.apply(null, rects.map(function(r){ return r.left;   })),
      right:  Math.max.apply(null, rects.map(function(r){ return r.right;  })),
      top:    Math.min.apply(null, rects.map(function(r){ return r.top;    })),
      bottom: Math.max.apply(null, rects.map(function(r){ return r.bottom; }))
    };
  }
  var vw = window.innerWidth, vh = window.innerHeight;
  /* 竖屏旋转后，左侧座位对和右侧座位对并不是镜像对称地分居屏幕上/下——旋转会把其中一对
     甩到物理屏幕顶边、另一对甩到物理屏幕底边(局部坐标系里对称，物理坐标系里不对称)。
     所以"贴在座位对下方"不能死认下方：下方放不下(会出屏)就改放上方 */
  /* 浏览器标签页直开时边距留大一点，降低被浏览器自己的地址栏/手势条遮住或误触的概率
     （已装桌面的PWA是固定全屏，不需要这层额外余量）*/
  var EDGE_MARGIN = IS_STANDALONE ? 8 : 20;
  function safeY(box){
    var below = box.bottom + 16 + btnH / 2;
    if (below + btnH / 2 <= vh - EDGE_MARGIN) return below;
    var above = box.top - 16 - btnH / 2;
    if (above - btnH / 2 >= EDGE_MARGIN) return above;
    return Math.min(Math.max(below, btnH / 2 + EDGE_MARGIN), vh - btnH / 2 - EDGE_MARGIN);
  }
  var leftBox  = pairBox([5, 6]);   // 左侧两个座位框(左上+左下)
  var rightBox = pairBox([2, 3]);   // 右侧两个座位框(右下+右上)
  var leftX, rightX, passY, playY;
  if (leftBox && rightBox) {
    /* 不再往中心线收拢——直接对齐左/右座位框自身中心，"贴在玩家框正下方" */
    leftX  = (leftBox.left  + leftBox.right)  / 2;
    rightX = (rightBox.left + rightBox.right) / 2;
    passY  = safeY(leftBox);
    playY  = safeY(rightBox);
  } else {   // 座位格还没渲染时(极早期)的兜底
    leftX = vw * 0.30; rightX = vw * 0.70; passY = playY = 40 + btnH / 2;
  }
  var passPt = gdToLocal(leftX, passY);
  var playPt = gdToLocal(rightX, playY);
  passBtn.style.left = passPt.x + 'px'; passBtn.style.top = passPt.y + 'px';
  playBtn.style.left = playPt.x + 'px'; playBtn.style.top = playPt.y + 'px';
}
window.addEventListener('resize', positionActionBar6p);
window.addEventListener('orientationchange', function(){ setTimeout(positionActionBar6p, 60); setTimeout(positionActionBar6p, 300); });
/* 兜底：安卓浏览器地址栏收起/展开、软键盘弹出等场景经常不触发(或延迟很久才触发) resize，
   导致按钮跟座位框的对应关系"看起来在动"。ResizeObserver 只要 #hex-board 的实际渲染尺寸
   变化就会立刻回调，比等 resize 事件可靠得多；不支持的老环境仍有上面两个监听兜底，不会更差。 */
if (typeof ResizeObserver === 'function') {
  var _hexBoardEl = document.getElementById('hex-board');   // 脚本在 body 末尾，元素已存在于 DOM 中
  if (_hexBoardEl) new ResizeObserver(function(){ positionActionBar6p(); }).observe(_hexBoardEl);
}
function renderSeatPlays(sp){
  sp = sp || {};
  var total = (GAME_MODE === '6p') ? 6 : 4;
  var cx = window.innerWidth/2, cy = window.innerHeight/2;
  for (var seat = 1; seat <= total; seat++){
    var el = document.getElementById('seat-play-'+seat);
    var play = sp[seat];
    var panel = seatPanelEl(seat);
    if (!play || !panel){ if(el) el.style.display='none'; continue; }
    var r = panel.getBoundingClientRect();
    if (r.width === 0 && r.height === 0){ if(el) el.style.display='none'; continue; }
    if (!el){ el = document.createElement('div'); el.id = 'seat-play-'+seat; el.className = 'seat-play'; document.body.appendChild(el); }
    if (play.pass){
      el.innerHTML = '<span class="sp-pass">不出</span>';
    } else {
      /* 从小到大排列，每行最多6张(最多14张) */
      el.innerHTML = playCardsRowsHtml(play.cards, 14);
    }
    var px = r.left + r.width/2, py = r.top + r.height/2;
    var dx = cx - px, dy = cy - py, len = Math.sqrt(dx*dx + dy*dy) || 1;
    var off = Math.min(len * 0.4, 105);   /* 倒计时球已停在右下死区，各家出牌统一贴座位即可 */
    var pos = gdToLocal(px + dx/len*off, py + dy/len*off);   // 竖屏旋转换算
    el.style.display = 'flex';
    el.style.left = pos.x + 'px';
    el.style.top  = pos.y + 'px';
  }
}

