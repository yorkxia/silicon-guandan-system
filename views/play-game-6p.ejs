}
function chatEditSave(){
  if(!_chatEditCred) return;
  var rows = document.querySelectorAll('#cem-list input');
  var phrases = Array.prototype.map.call(rows, function(i){ return i.value.trim(); }).filter(function(s){ return s; });
  var errEl = document.getElementById('cem-err2');
  if(!phrases.length){ errEl.textContent = '至少保留一条话术'; return; }
  errEl.textContent = '保存中...';
  fetch('/api/gd/chat-phrases/save', { method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ username:_chatEditCred.username, password:_chatEditCred.password, phrases:phrases }) })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(!d.ok){ errEl.textContent = d.error || '保存失败'; return; }
      CHAT_QUICKS = d.phrases;
      initChatPanel();
      closeChatEditModal();
    })
    .catch(function(){ errEl.textContent = '网络错误，请重试'; });
}
function chatSend(text){
  if(!text) return;
  socket.emit('chat:msg', { token:MY_TOKEN, roomCode:ROOM_CODE, text:String(text).slice(0,30) });
  closeChatPanel();
}
function showChatBubble(seat, text, name){
  var el  = (seat!=null && typeof tbSeatEl==='function') ? tbSeatEl(seat) : null;
  var r   = el ? el.getBoundingClientRect() : null;
  var anchored = !!(r && (r.width || r.height));   // 座位锚点可用？
  var key = 'cb_' + (seat==null ? 'x' : seat), old = _chatBubbles[key];
  if(old){ clearTimeout(old.t); if(old.el) old.el.remove(); }
  var b=document.createElement('div'); b.className='chat-bubble';
  if(name){ var nm=document.createElement('span'); nm.className='cb-name'; nm.textContent=name+'：'; b.appendChild(nm); }
  b.appendChild(document.createTextNode(text));
  var pos;
  if(anchored){
    pos = gdToLocal(r.left + r.width/2, Math.max(r.top, 40));   // 座位上方（竖屏旋转换算）
    b.style.transform = 'translate(-50%, -100%)';
  } else {
    /* 兜底：座位锚点隐藏/0尺寸/等候中时，从屏幕顶部中央飘出，保证消息一定可见 */
    pos = gdToLocal(window.innerWidth/2, 58);
    b.style.transform = 'translate(-50%, 0)';
    b.classList.add('cb-toast');
  }
  b.style.left = pos.x+'px';
  b.style.top  = pos.y+'px';
  document.body.appendChild(b);
  var t=setTimeout(function(){ if(b) b.remove(); delete _chatBubbles[key]; }, 4200);
  _chatBubbles[key]={el:b,t:t};
}
/* 全桌公开显示：任何人发的消息，所有玩家都在其座位上方看到（含发言人名字）*/
socket.on('chat:msg', function(d){
  if(!d || !d.text) return;
  var seat = (d.seat!=null) ? d.seat : (typeof tbSeatOfPlayer==='function' ? tbSeatOfPlayer(d.playerId) : null);
  showChatBubble(seat, d.text, d.name);
});

function tbPlaceCursor(seat, text, cls){
  var el = tbSeatEl(seat); if (!el) return;
  var r = el.getBoundingClientRect(); if (!r.width) return;
  var b = document.createElement('div');
  b.className = 'tb-cursor ' + cls; b.textContent = text;
  var pos = gdToLocal(r.left + r.width/2, Math.max(r.top, 30) - 4);   // 竖屏旋转换算
  b.style.left = pos.x + 'px';
  b.style.top  = pos.y + 'px';
  document.getElementById('tb-cursor-layer').appendChild(b);
}
function renderTributeUI(){
  var layer = document.getElementById('tb-cursor-layer'); if (layer) layer.innerHTML = '';
  var prompt = document.getElementById('tb-prompt');      if (prompt) prompt.style.display = 'none';
  if (!tbEx.length){ render6pHand(myHand); return; }
  tbEx.forEach(function(e){
    if (e.stage === 'give'){
      tbPlaceCursor(e.giverSeat,    '🔴 请点击供牌', 'give');
      tbPlaceCursor(e.receiverSeat, '⚪ 请点击还供', 'wait');
    } else if (e.stage === 'return'){
      tbPlaceCursor(e.receiverSeat, '🔵 请点击还供', 'ret');
    }
  });
  if (!tbBusy && prompt){
    if (tbMyGiveEx())        { prompt.textContent = '👇 请点击你要供出的最大牌'; prompt.style.display = 'block'; }
    else if (tbMyReturnEx()) { prompt.textContent = '👇 请点击你要还供的牌（点数≤10，非级牌）'; prompt.style.display = 'block'; }
  }
  render6pHand(myHand);
}
function tbTapCard(code){
  if (tbBusy) return true;
  var g = tbMyGiveEx();
  if (g){
    if (tbGiveCandsOf(g).indexOf(code) >= 0){
      tbBusy = true; document.getElementById('tb-prompt').style.display = 'none';
      socket.emit('tribute:give', { token:MY_TOKEN, roomCode:ROOM_CODE, card:code });
    } else { showToast('请点击高亮的最大牌供出'); }
    return true;
  }
  var r = tbMyReturnEx();
  if (r){
    if (canReturnCard(code)){
      tbBusy = true; document.getElementById('tb-prompt').style.display = 'none';
      socket.emit('tribute:return', { token:MY_TOKEN, roomCode:ROOM_CODE, returnCard:code });
    } else { showToast('还供需点数≤10且非级牌'); }
    return true;
  }
  return false;
}
window.addEventListener('resize', function(){ if (tbEx.length) renderTributeUI(); });

/* ══════ 并列贡牌：还供牌摆中间供选(谁离头游名次近谁先选，7/20 秒仲裁，超时随机) ══════
   仅全下(双下/六人三下)且贡牌大小分不出高低时才会触发；tieCards 保存 {giverId, card} 列表。 */
var tieCards = [], tieGiverIds = [], tieActiveId = null, tieDeadline = 0, tieCountdownTimer = null;
function tieNameOf(pid){ var p = players.find(function(x){ return x.playerId===pid; }); return p?p.name:''; }
function stopTieCountdown(){ if (tieCountdownTimer){ clearInterval(tieCountdownTimer); tieCountdownTimer=null; } }
function renderTieOverlay(){
  var ov = document.getElementById('tie-overlay');
  if (!tieCards.length){ ov.style.display = 'none'; stopTieCountdown(); return; }
  ov.style.display = 'block';
  var iAmActive = (tieActiveId === myPlayerId);
  var hint = document.getElementById('tie-hint');
  hint.textContent = iAmActive
    ? '几张进贡的牌大小相同，轮到您先选一张还供牌'
    : ('请靠近头游的玩家先选牌：等待 ' + esc(tieNameOf(tieActiveId)) + ' 选牌…');
  var box = document.getElementById('tie-cards');
  box.innerHTML = '';
  tieCards.forEach(function(c){
    var el = document.createElement('div');
    el.className = 'tie-card-box' + (iAmActive ? ' pickable' : '');
    el.innerHTML = '<div class="tc-face">' + cardEmoji(c.card) + '</div><div class="tc-who">' + esc(tieNameOf(c.giverId)) + '</div>';
    if (iAmActive) el.onclick = function(){
      socket.emit('tribute:tie_pick', { token: MY_TOKEN, roomCode: ROOM_CODE, card: c.card });
    };
    box.appendChild(el);
  });
  stopTieCountdown();
  var cd = document.getElementById('tie-countdown');
  var tick = function(){
    var s = Math.max(0, Math.ceil((tieDeadline - Date.now()) / 1000));
    cd.textContent = s > 0 ? ('剩余 ' + s + ' 秒，超时系统将随机分配') : '正在结算…';
  };
  tick();
  tieCountdownTimer = setInterval(tick, 500);
}
socket.on('tribute:tie_pending', function(d){
  tieCards     = (d.giverIds || []).map(function(gid, i){ return { giverId: gid, card: (d.cards||[])[i] }; });
  tieGiverIds  = d.giverIds || [];
  tieActiveId  = d.firstPickerId;
  tieDeadline  = Date.now() + (d.totalMs || 20000);
  renderTieOverlay();
});
socket.on('tribute:tie_turn', function(d){
  tieActiveId = d.activeGiverId;
  renderTieOverlay();
});
socket.on('tribute:tie_done', function(){
  tieCards = []; tieGiverIds = []; tieActiveId = null;
  renderTieOverlay();
});

socket.on('tribute:phase', function(d) {
  document.getElementById('tribute-overlay').style.display = 'none';
  tbBusy = false;
  tbEx = (d.exchanges || []).map(function(e){
    return {
      giverId: e.giverId, receiverId: e.receiverId,
      giverSeat: tbSeatOfPlayer(e.giverId), receiverSeat: tbSeatOfPlayer(e.receiverId),
      giveCandidates: e.giveCandidates || [], mustGiveCard: e.mustGiveCard,
      stage: e.stage || 'give', tributeCard: e.tributeCard || null
    };
  });
  renderTributeUI();
});

socket.on('tribute:resisted', function(d) {
