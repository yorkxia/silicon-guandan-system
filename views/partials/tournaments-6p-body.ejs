<style>
    .a-main {
      background: linear-gradient(165deg, #E8F0FA 0%, #F0F4FB 48%, #EAF2FF 100%) !important;
      min-height: 100vh;
    }

    /* ── 顶部标题区 ── */
    .ms-header {
      display: flex;
      align-items: center;
      gap: 16px;
      max-width: 760px;
      margin: 0 auto 22px;
      padding-bottom: 16px;
      border-bottom: 2px solid rgba(0,85,187,0.14);
    }
    .ms-header-logo {
      width: 54px; height: 54px; border-radius: 50%;
      border: 2px solid #6699DD; object-fit: cover;
      box-shadow: 0 4px 14px rgba(0,85,187,0.2);
    }
    .ms-header-text h1 {
      font-size: 1.32rem; font-weight: 900; color: #0A3A80;
      letter-spacing: 2px; margin: 0 0 3px;
    }
    .ms-header-text p {
      font-size: 0.74rem; color: #999; letter-spacing: 2px; margin: 0;
    }
    .ms-back {
      margin-left: auto; padding: 7px 16px; border-radius: 8px;
      background: rgba(0,85,187,0.08); color: #0055BB;
      border: 1px solid rgba(0,85,187,0.25); font-size: 0.8rem;
      text-decoration: none; transition: all 0.2s; white-space: nowrap;
    }
    .ms-back:hover { background: rgba(0,85,187,0.15); color:#003380; text-decoration:none; }

    /* ── 布局容器 ── */
    .ms-wrap { max-width: 760px; margin: 0 auto; }

    /* 通用卡片交互 */
    .ms-hero, .ms-card {
      position: relative; overflow: hidden;
      text-decoration: none; color: inherit; cursor: pointer;
      background: #fff; border-radius: 20px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.10);
      transition: transform .28s ease, box-shadow .28s ease;
      border: 1px solid rgba(0,0,0,0.04);
    }
    .ms-hero:hover, .ms-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 48px rgba(0,0,0,0.17);
      text-decoration: none; color: inherit;
    }

    /* ── 主推：个人随机（金） ── */
    .ms-hero {
      display: flex; align-items: center; gap: 22px;
      padding: 26px 28px; margin-bottom: 20px;
      background: linear-gradient(135deg, #FFFBF0 0%, #FFF3D6 100%);
      border: 1px solid #F0D89A;
    }
    .ms-hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(circle at 88% -20%, rgba(232,160,32,0.22), transparent 55%);
      pointer-events: none;
    }
    .ms-hero-icon {
      flex-shrink: 0; width: 76px; height: 76px; border-radius: 20px;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.2rem; color: #fff; z-index: 1;
      background: linear-gradient(135deg, #E8A020, #A86800);
      box-shadow: 0 8px 22px rgba(232,160,32,0.45);
    }
    .ms-hero-main { flex: 1; min-width: 0; z-index: 1; }
    .ms-hero-title {
      font-size: 1.4rem; font-weight: 900; color: #7A4A00;
      letter-spacing: 3px; margin-bottom: 6px;
    }
    .ms-hero-sub {
      font-size: 0.84rem; color: #9A7020; letter-spacing: .5px; margin-bottom: 12px;
    }
    .ms-hero-cta {
      flex-shrink: 0; z-index: 1; padding: 15px 26px; border-radius: 12px;
      font-size: 0.98rem; font-weight: 800; letter-spacing: 2px;
      color: #fff; white-space: nowrap;
      background: linear-gradient(135deg, #E8A020, #A86800);
      box-shadow: 0 6px 18px rgba(232,160,32,0.42);
      transition: all .2s;
    }
    .ms-hero:hover .ms-hero-cta {
      background: linear-gradient(135deg, #F5B030, #C8860A);
      transform: translateY(-1px);
    }

    /* chips */
    .ms-chips { display: flex; flex-wrap: wrap; gap: 7px; }
    .ms-chips span {
      padding: 3px 11px; border-radius: 14px; font-size: 0.72rem;
      font-weight: 600; letter-spacing: .5px;
      background: rgba(232,160,32,0.12); color: #A86800;
      border: 1px solid rgba(232,160,32,0.30);
    }

    /* ── 双次级行 ── */
    .ms-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .ms-card {
      display: flex; flex-direction: column; padding: 22px 22px 20px; text-align: center;
    }
    .ms-card-icon {
      width: 58px; height: 58px; border-radius: 16px; margin: 0 auto 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.7rem; color: #fff;
    }
    .ms-card-main { width: 100%; flex: 1; display: flex; flex-direction: column; }
    .ms-card-title { font-size: 1.12rem; font-weight: 900; letter-spacing: 2px; margin-bottom: 5px; }
    .ms-card-sub { font-size: 0.78rem; color: #777; line-height: 1.6; margin-bottom: 12px; flex: 1; }
    .ms-chips-sm { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-bottom: 16px; }
    .ms-chips-sm span {
      padding: 2px 9px; border-radius: 12px; font-size: 0.68rem; font-weight: 600;
      border: 1px solid;
    }
    .ms-btn {
      width: 100%; padding: 12px 0; border-radius: 11px;
      font-size: 0.9rem; font-weight: 800; letter-spacing: 1.5px;
      color: #fff; transition: all .2s;
    }

    /* 亲友开房（绿） */
    .ms-green .ms-card-icon { background: linear-gradient(135deg,#27AE60,#1A7A40); box-shadow:0 6px 18px rgba(39,174,96,0.38); }
    .ms-green .ms-card-title { color: #155A30; }
    .ms-green .ms-chips-sm span { background:#DCF5E8; color:#1A7A40; border-color:#80D4A8; }
    .ms-green .ms-btn { background: linear-gradient(135deg,#27AE60,#1A7A40); box-shadow:0 4px 14px rgba(39,174,96,0.38); }
    .ms-green:hover .ms-btn { background: linear-gradient(135deg,#2ECC71,#219A52); }

    /* 大型联赛（紫） */
    .ms-purple .ms-card-icon { background: linear-gradient(135deg,#7B52D4,#4A2290); box-shadow:0 6px 18px rgba(123,82,212,0.38); }
    .ms-purple .ms-card-title { color: #3D1E80; }
    .ms-purple .ms-chips-sm span { background:#EDE7FF; color:#6C3EBB; border-color:#B09CE0; }
    .ms-purple .ms-btn { background: linear-gradient(135deg,#7B52D4,#4A2290); box-shadow:0 4px 14px rgba(123,82,212,0.38); }
    .ms-purple:hover .ms-btn { background: linear-gradient(135deg,#9066E8,#5A30A8); }

    /* 即将开放角标 */
    .ms-badge {
      position: absolute; top: 12px; right: 12px; z-index: 2;
      padding: 3px 10px; border-radius: 10px; font-size: 0.64rem; font-weight: 700;
      letter-spacing: 1px; color: #6C3EBB; background: #EDE7FF;
      border: 1px solid #B09CE0;
    }

    /* 小提示 */
    .ms-hint {
      max-width: 760px; margin: 22px auto 0; padding: 12px 18px;
      background: rgba(0,85,187,0.05); border-radius: 10px;
      border-left: 4px solid #6699DD; font-size: 0.78rem; color: #666; line-height: 1.7;
    }

    /* ── 手机端：三项浓缩为紧凑横条，一屏全显示 ── */
    @media (max-width: 720px) {
      .ms-header { flex-wrap: wrap; margin-bottom: 14px; padding-bottom: 12px; }
      .ms-header-logo { width: 46px; height: 46px; }
      .ms-header-text h1 { font-size: 1.16rem; }

      .ms-hero, .ms-card {
        flex-direction: row; align-items: center; text-align: left;
        gap: 13px; padding: 14px 15px;
      }
      .ms-hero { margin-bottom: 14px; }
      .ms-row { grid-template-columns: 1fr; gap: 14px; }

      .ms-hero-icon { width: 52px; height: 52px; font-size: 1.55rem; border-radius: 15px; }
      .ms-card-icon { width: 52px; height: 52px; margin: 0; font-size: 1.5rem; border-radius: 15px; flex-shrink: 0; }

      .ms-hero-main, .ms-card-main { flex: 1; min-width: 0; text-align: left; }
      .ms-hero-title { font-size: 1.12rem; letter-spacing: 1px; margin-bottom: 2px; }
      .ms-hero-sub  { font-size: 0.74rem; margin-bottom: 0; }
      .ms-card-title { font-size: 1.04rem; letter-spacing: 1px; margin-bottom: 2px; }
      .ms-card-sub  { font-size: 0.73rem; margin-bottom: 0; flex: none; }

      .ms-chips, .ms-chips-sm { display: none; }

      .ms-hero-cta {
        flex-shrink: 0; width: auto; padding: 11px 15px;
        font-size: 0.82rem; letter-spacing: 0;
      }
      .ms-btn {
        width: auto; flex-shrink: 0; padding: 11px 15px;
        font-size: 0.8rem; letter-spacing: 0; white-space: nowrap;
      }
    }
</style>

